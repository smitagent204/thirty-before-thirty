  {
    id: "l2-8",
    level: 2,
    order: 8,
    points: 2,
    emoji: "\u{1F32E}",
    title: "\u0413\u0430\u0441\u0442\u0440\u043E-\u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435 \u043D\u0430 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439 \u043A\u0443\u0445\u043D\u0435",
    description: "\u0412\u044B\u0431\u0435\u0440\u0438 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F, \u0437\u0430\u0436\u0433\u0438 \u0441\u0432\u0435\u0447\u0438 \u0438 \u0437\u0430\u043A\u0430\u0436\u0438 \u043A\u0443\u0445\u043D\u044E, \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0432\u044B \u0435\u0449\u0451 \u043D\u0435 \u043F\u0440\u043E\u0431\u043E\u0432\u0430\u043B\u0438: \u043F\u0435\u0440\u0443\u0430\u043D\u0441\u043A\u0443\u044E, \u0432\u044C\u0435\u0442\u043D\u0430\u043C\u0441\u043A\u0443\u044E, \u043C\u0435\u043A\u0441\u0438\u043A\u0430\u043D\u0441\u043A\u0443\u044E \u0438\u043B\u0438 \u0433\u0440\u0443\u0437\u0438\u043D\u0441\u043A\u0443\u044E. \u041F\u0435\u0440\u0435\u043B\u043E\u0436\u0438 \u0435\u0434\u0443 \u043D\u0430 \u043F\u043E\u0441\u0443\u0434\u0443, \u0443\u0431\u0435\u0440\u0438 \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u044B \u0438 \u0443\u0441\u0442\u0440\u043E\u0439 \u0443\u0436\u0438\u043D \u043A\u0430\u043A \u0432 \u0440\u0435\u0441\u0442\u043E\u0440\u0430\u043D\u0435. \u0411\u0435\u0437 \u0432\u044B\u0435\u0437\u0434\u0430 \u0438\u0437 \u0434\u043E\u043C\u0430.",
    photoHint: "\u0421\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u0439 \u0441\u0435\u0440\u0432\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u0441\u0442\u043E\u043B \u0441\u043E \u0441\u0432\u0435\u0447\u0430\u043C\u0438 \u0438 \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u044B\u043C\u0438 \u0431\u043B\u044E\u0434\u0430\u043C\u0438, \u043F\u0435\u0440\u0435\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u043C\u0438 \u043D\u0430 \u043F\u043E\u0441\u0443\u0434\u0443.",
    rubric: {
