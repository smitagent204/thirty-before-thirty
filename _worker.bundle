    title: "\u0424\u043E\u0442\u043E\u043E\u0445\u043E\u0442\u0430 \xAB6 \u0437\u0438\u043C\u043D\u0438\u0445 \u043E\u043A\u043E\u043D\xBB",
    description: "\u0412\u043E\u0437\u044C\u043C\u0438 \u043C\u0430\u043B\u044B\u0448\u0430 \u0432 \u0441\u043B\u0438\u043D\u0433 \u0438\u043B\u0438 \u043A\u043E\u043B\u044F\u0441\u043A\u0443 \u0438 \u043F\u0440\u043E\u0439\u0434\u0438 \u0441\u0432\u043E\u0439 \u0440\u0430\u0439\u043E\u043D \u0441 \u0444\u043E\u0442\u043E\u0430\u043F\u043F\u0430\u0440\u0430\u0442\u043E\u043C. \u041D\u0430\u0439\u0434\u0438 \u0448\u0435\u0441\u0442\u044C \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0445 \u0437\u0438\u043C\u043D\u0438\u0445 \u043E\u043A\u043E\u043D, \u0432\u0438\u0442\u0440\u0438\u043D \u0438\u043B\u0438 \u0441\u043D\u0435\u0436\u043D\u044B\u0445 \u0434\u0435\u0442\u0430\u043B\u0435\u0439 \u2014 \u0433\u0438\u0440\u043B\u044F\u043D\u0434\u044B, \u0431\u0443\u043C\u0430\u0436\u043D\u044B\u0435 \u0441\u043D\u0435\u0436\u0438\u043D\u043A\u0438, \u0442\u0451\u043F\u043B\u044B\u0439 \u0441\u0432\u0435\u0442. \u0421\u043E\u0431\u0435\u0440\u0438 \u0438\u0437 \u0448\u0435\u0441\u0442\u0438 \u043A\u0430\u0434\u0440\u043E\u0432 \u043A\u043E\u043B\u043B\u0430\u0436: \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F \u043A\u0430\u0440\u0442\u0430 \u0443\u044E\u0442\u0430 \u0414\u044B\u0431\u0435\u043D\u043A\u043E.",
    photoHint: "\u0417\u0430\u0433\u0440\u0443\u0437\u0438 \u043A\u043E\u043B\u043B\u0430\u0436 \u0438\u0437 \u0448\u0435\u0441\u0442\u0438 \u0440\u0430\u0437\u043D\u044B\u0445 \u0437\u0438\u043C\u043D\u0438\u0445 \u043A\u0430\u0434\u0440\u043E\u0432: \u043E\u043A\u043D\u0430, \u0432\u0438\u0442\u0440\u0438\u043D\u044B \u0438\u043B\u0438 \u0441\u043D\u0435\u0436\u043D\u044B\u0435 \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u0438\u044F. \u0412\u0430\u0436\u043D\u043E, \u0447\u0442\u043E\u0431\u044B \u0431\u044B\u043B\u043E \u0432\u0438\u0434\u043D\u043E, \u0447\u0442\u043E \u044D\u0442\u043E \u0440\u0430\u0437\u043D\u044B\u0435 \u043C\u0435\u0441\u0442\u0430, \u0430 \u043D\u0435 \u043E\u0434\u043D\u043E \u043E\u043A\u043D\u043E \u0448\u0435\u0441\u0442\u044C \u0440\u0430\u0437.",
