    allowCollage: true,
    emoji: "\u{1F457}",
    title: "\u0414\u043E\u043C\u0430\u0448\u043D\u0438\u0439 \u043F\u043E\u0434\u0438\u0443\u043C \xAB\u0413\u0430\u0440\u0434\u0435\u0440\u043E\u0431 \u0432\u043D\u0435 \u0434\u0435\u043A\u0440\u0435\u0442\u0430\xBB",
    description: "\u0414\u043E\u0441\u0442\u0430\u043D\u044C \u0442\u0440\u0438 \u043D\u0430\u0440\u044F\u0434\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043D\u0435 \u043D\u0430\u0434\u0435\u0432\u0430\u043B\u0430 \u0431\u043E\u043B\u044C\u0448\u0435 \u0433\u043E\u0434\u0430: \u043F\u043B\u0430\u0442\u044C\u044F, \u043F\u0438\u0434\u0436\u0430\u043A\u0438, \u0442\u0443\u0444\u043B\u0438. \u041F\u043E\u0434 \u043C\u0443\u0437\u044B\u043A\u0443 \u0441\u043E\u0431\u0435\u0440\u0438 \u0442\u0440\u0438 \u043E\u0431\u0440\u0430\u0437\u0430 \u0441 \u044F\u0440\u043A\u043E\u0439 \u043F\u043E\u043C\u0430\u0434\u043E\u0439 \u0438 \u0441\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u0439 \u043A\u0430\u0436\u0434\u044B\u0439 \u0443 \u0437\u0435\u0440\u043A\u0430\u043B\u0430 \u0438\u043B\u0438 \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435. \u041A\u043E\u043B\u043B\u0430\u0436 \u0438\u0437 \u0442\u0440\u0451\u0445 \u043A\u0430\u0434\u0440\u043E\u0432 \u0441\u0442\u0430\u043D\u0435\u0442 \u0448\u043F\u0430\u0440\u0433\u0430\u043B\u043A\u043E\u0439 \u0434\u043B\u044F \u0431\u0443\u0434\u0443\u0449\u0438\u0445 \u0432\u044B\u0445\u043E\u0434\u043E\u0432.",
    photoHint: "\u0421\u043E\u0431\u0435\u0440\u0438 \u043A\u043E\u043B\u043B\u0430\u0436 \u0438\u0437 \u0442\u0440\u0451\u0445 \u0444\u043E\u0442\u043E \u2014 \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443 \u043D\u0430 \u043A\u0430\u0436\u0434\u044B\u0439 \u043E\u0431\u0440\u0430\u0437. \u0414\u043E\u043B\u0436\u043D\u044B \u0431\u044B\u0442\u044C \u0432\u0438\u0434\u043D\u044B \u0440\u0430\u0437\u043D\u044B\u0435 \u043D\u0430\u0440\u044F\u0434\u044B \u0438 \u044F\u0440\u043A\u0430\u044F \u043F\u043E\u043C\u0430\u0434\u0430.",
