          id: "artwork",
          label: "\u043D\u0430 \u0444\u043E\u0442\u043E \u0445\u043E\u043B\u0441\u0442, \u043F\u043B\u043E\u0442\u043D\u0430\u044F \u0431\u0443\u043C\u0430\u0433\u0430 \u0438\u043B\u0438 \u043A\u0430\u0440\u0442\u0438\u043D\u0430",
          miss: "\u043D\u0430 \u0444\u043E\u0442\u043E \u043D\u0435\u0442 \u0445\u043E\u043B\u0441\u0442\u0430 \u0438\u043B\u0438 \u043A\u0430\u0440\u0442\u0438\u043D\u044B",
