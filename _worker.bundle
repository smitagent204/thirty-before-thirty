          label: "\u0432\u0438\u0434\u043D\u044B \u0441\u0432\u0435\u0447\u0438 \u0438\u043B\u0438 \u043F\u0440\u0438\u0433\u043B\u0443\u0448\u0451\u043D\u043D\u044B\u0439 \u0440\u043E\u043C\u0430\u043D\u0442\u0438\u0447\u043D\u044B\u0439 \u0441\u0432\u0435\u0442",
          miss: "\u043D\u0435\u0442 \u0441\u0432\u0435\u0447\u0435\u0439 \u0438\u043B\u0438 \u0440\u043E\u043C\u0430\u043D\u0442\u0438\u0447\u043D\u043E\u0433\u043E \u0441\u0432\u0435\u0442\u0430",
