        {
          id: "cuisine",
          label: "\u0431\u043B\u044E\u0434\u0430 \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u043E\u0439 \u043A\u0443\u0445\u043D\u0438: \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u044B\u0435 \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442\u044B, \u0441\u043F\u0435\u0446\u0438\u0438 \u0438\u043B\u0438 \u0441\u043E\u0443\u0441\u044B",
          miss: "\u043E\u0431\u044B\u0447\u043D\u0430\u044F \u0434\u043E\u043C\u0430\u0448\u043D\u044F\u044F \u0435\u0434\u0430",
