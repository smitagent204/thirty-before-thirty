          label: "\u0431\u0443\u043C\u0430\u0436\u043D\u0430\u044F \u043A\u043D\u0438\u0433\u0430",
          miss: "\u043D\u0435\u0442 \u0431\u0443\u043C\u0430\u0436\u043D\u043E\u0439 \u043A\u043D\u0438\u0433\u0438",
          weight: 35
        },
        {
          id: "open_text",
          label: "\u043A\u043D\u0438\u0433\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u0430, \u0432\u0438\u0434\u043D\u0430 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430 \u0441 \u0442\u0435\u043A\u0441\u0442\u043E\u043C",
          miss: "\u043A\u043D\u0438\u0433\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u0430 \u0438\u043B\u0438 \u0442\u0435\u043A\u0441\u0442\u0430 \u043D\u0435 \u0432\u0438\u0434\u043D\u043E",
          weight: 25
