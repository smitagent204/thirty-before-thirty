          label: "\u0435\u0434\u0430 \u043D\u0430 \u043F\u043E\u0441\u0443\u0434\u0435, \u0431\u0435\u0437 \u043F\u043B\u0430\u0441\u0442\u0438\u043A\u043E\u0432\u044B\u0445 \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u043E\u0432 \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0438",
          miss: "\u0435\u0434\u0430 \u0432 \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u0430\u0445 \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0438",
          weight: 20
