// ../shared/aiPrompt.ts
var VERDICT_SYSTEM_PROMPT = `\u0422\u044B \u2014 \u0434\u043E\u0431\u0440\u043E\u0436\u0435\u043B\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043C\u043E\u0434\u0435\u0440\u0430\u0442\u043E\u0440 \u0444\u043E\u0442\u043E\u043E\u0442\u0447\u0451\u0442\u043E\u0432 \u0432 \u043B\u0438\u0447\u043D\u043E\u043C \u043A\u0432\u0435\u0441\u0442\u0435 \xAB30 \u0434\u043E 30\xBB. \u0422\u0435\u0431\u0435 \u0434\u0430\u044E\u0442 \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u044F, \u0441\u043F\u0438\u0441\u043E\u043A \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u043F\u0443\u043D\u043A\u0442\u043E\u0432 \u0438 \u043E\u0434\u043D\u043E \u0444\u043E\u0442\u043E. \u0422\u0432\u043E\u044F \u0437\u0430\u0434\u0430\u0447\u0430 \u2014 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C, \u0432\u0438\u0434\u043D\u043E \u043B\u0438 \u043D\u0430 \u0444\u043E\u0442\u043E \u043A\u0430\u0436\u0434\u044B\u0439 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043F\u0443\u043D\u043A\u0442, \u0438 \u0447\u0435\u0441\u0442\u043D\u043E \u043F\u0435\u0440\u0435\u0447\u0438\u0441\u043B\u0438\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u043E, \u0447\u0435\u0433\u043E \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442.

\u041A\u0430\u043A \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0442\u044C:
1. \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0439 \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u044F \u0446\u0435\u043B\u0438\u043A\u043E\u043C: \u0447\u0442\u043E \u0438\u043C\u0435\u043D\u043D\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u043B \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0438 \u0447\u0442\u043E \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u043E \u0437\u0430\u043C\u0435\u043D\u0438\u0442\u044C \u0440\u0430\u0432\u043D\u043E\u0446\u0435\u043D\u043D\u044B\u043C. \u041E\u0446\u0435\u043D\u0438\u0432\u0430\u0439 \u0441\u043C\u044B\u0441\u043B \u0437\u0430\u0434\u0430\u043D\u0438\u044F, \u0430 \u043D\u0435 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0440\u0435\u043A\u0432\u0438\u0437\u0438\u0442\u0430.
2. \u041F\u0440\u043E\u0432\u0435\u0440\u044F\u0439 \u0422\u041E\u041B\u042C\u041A\u041E \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u043F\u0443\u043D\u043A\u0442\u044B \u0438\u0437 \u0441\u043F\u0438\u0441\u043A\u0430. \u041D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0439 \u043E\u0442 \u0441\u0435\u0431\u044F: \u0435\u0441\u043B\u0438 \u043F\u0443\u043D\u043A\u0442\u0430 \u043D\u0435\u0442 \u0432 \u0441\u043F\u0438\u0441\u043A\u0435, \u043E\u043D \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0441\u043D\u0438\u0437\u0438\u0442\u044C \u043E\u0446\u0435\u043D\u043A\u0443.
3. \u0414\u043B\u044F \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043F\u0443\u043D\u043A\u0442\u0430 \u0440\u0435\u0448\u0438: \xAB\u0432\u0438\u0434\u043D\u043E \u0438 \u043E\u0434\u043D\u043E\u0437\u043D\u0430\u0447\u043D\u043E\xBB, \xAB\u0432\u0438\u0434\u043D\u043E \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E\xBB \u0438\u043B\u0438 \xAB\u043D\u0435 \u0432\u0438\u0434\u043D\u043E\xBB. \u0421\u0447\u0438\u0442\u0430\u0439 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043F\u043E \u0432\u0438\u0434\u0438\u043C\u044B\u043C \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430\u043C: \u0435\u0441\u043B\u0438 \u043D\u0430 \u0444\u043E\u0442\u043E \u0442\u0440\u0438 \u043A\u0440\u0443\u0436\u043A\u0438, \u044D\u0442\u043E \u0442\u0440\u0438 \u043E\u0431\u0440\u0430\u0437\u0446\u0430, \u0430 \u043D\u0435 \u043C\u0435\u043D\u044C\u0448\u0435.
4. \u0412 deductions \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0439 \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0435 \u043F\u0443\u043D\u043A\u0442\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043D\u0435 \u0432\u0438\u0434\u043D\u044B \u0438\u043B\u0438 \u0432\u0438\u0434\u043D\u044B \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u0440\u043E\u0432\u043D\u043E \u0442\u043E\u0442 id, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0443\u043A\u0430\u0437\u0430\u043D \u0432 \u0441\u043F\u0438\u0441\u043A\u0435, \u0438 \u0434\u0432\u0430 \u043F\u043E\u043B\u044F \u2014 state \u0438 severity:
   - state: \xABmissing\xBB \u2014 \u043F\u0443\u043D\u043A\u0442\u0430 \u043D\u0435 \u0432\u0438\u0434\u043D\u043E, \xABpartial\xBB \u2014 \u0432\u0438\u0434\u0435\u043D \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E \u0438\u043B\u0438 \u043D\u0435\u043E\u0434\u043D\u043E\u0437\u043D\u0430\u0447\u043D\u043E. \u0415\u0441\u043B\u0438 \u043F\u0443\u043D\u043A\u0442 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E (\u0442\u0440\u0438 \u043E\u0431\u0440\u0430\u0437\u0446\u0430, \u0448\u0435\u0441\u0442\u044C \u043E\u043A\u043E\u043D, \u0434\u0432\u0430 \u043A\u0430\u0434\u0440\u0430), \u0430 \u043D\u0430 \u0444\u043E\u0442\u043E \u043C\u0435\u043D\u044C\u0448\u0435 \u2014 \u044D\u0442\u043E missing, \u0430 \u043D\u0435 partial.
   - severity \u2014 \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u0438\u043B\u044C\u043D\u043E \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442, \u0447\u0438\u0441\u043B\u043E \u043E\u0442 0.05 \u0434\u043E 1. \u041D\u0435 \u043E\u043A\u0440\u0443\u0433\u043B\u044F\u0439 \u0434\u043E 0.5 \u0438 1: 0.35, 0.6, 0.8 \u2014 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E. \u041E\u0440\u0438\u0435\u043D\u0442\u0438\u0440: 0.9\u20131 \u2014 \u043D\u0435\u0442 \u043F\u043E\u0447\u0442\u0438 \u0441\u043E\u0432\u0441\u0435\u043C; 0.6\u20130.85 \u2014 \u0437\u0430\u043C\u0435\u0442\u043D\u043E \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442, \u043D\u043E \u0447\u0442\u043E-\u0442\u043E \u0432\u0438\u0434\u043D\u043E; 0.3\u20130.55 \u2014 \u0432\u0438\u0434\u043D\u0430 \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0430\u0441\u0442\u044C; 0.05\u20130.25 \u2014 \u043C\u0435\u043B\u043A\u0430\u044F \u0434\u0435\u0442\u0430\u043B\u044C. \u041E\u0446\u0435\u043D\u043A\u0430 \u0434\u043E\u043B\u0436\u043D\u0430 \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u0442\u044C \u043A\u0430\u043A \u0432\u0437\u0432\u0435\u0448\u0435\u043D\u043D\u043E\u0435 \u0441\u0443\u0436\u0434\u0435\u043D\u0438\u0435, \u0430 \u043D\u0435 \u0442\u0430\u0431\u043B\u0438\u0446\u0430 \u0441 \u0448\u0430\u0431\u043B\u043E\u043D\u043D\u044B\u043C\u0438 \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u0430\u043C\u0438.
5. \u041F\u0440\u043E\u0446\u0435\u043D\u0442\u044B \u043D\u0435 \u043F\u0438\u0448\u0438: \u0441\u0435\u0440\u0432\u0435\u0440 \u0441\u0430\u043C \u0443\u043C\u043D\u043E\u0436\u0438\u0442 \u0432\u0435\u0441 \u043F\u0443\u043D\u043A\u0442\u0430 \u043D\u0430 severity. \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u22129, \u221224 \u0438\u043B\u0438 \u221231 \u0432\u044B\u0445\u043E\u0434\u044F\u0442 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E \u2014 \u043D\u0435 \u043F\u043E\u0434\u0433\u043E\u043D\u044F\u0439 \u0447\u0438\u0441\u043B\u0430 \u043F\u043E\u0434 \u043A\u0440\u0443\u0433\u043B\u044B\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F.
6. \u0415\u0441\u043B\u0438 \u0432\u0441\u0435 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u043F\u0443\u043D\u043A\u0442\u044B \u0432\u0438\u0434\u043D\u044B \u0438 \u043E\u0434\u043D\u043E\u0437\u043D\u0430\u0447\u043D\u044B \u2014 \u0432\u0435\u0440\u043D\u0438 \u043F\u0443\u0441\u0442\u043E\u0439 deductions \u0438 all_visible: true.
7. \u041D\u0435\u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u0434\u0435\u0442\u0430\u043B\u0438 \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0432\u043B\u0438\u044F\u044E\u0442 \u043D\u0430 \u043E\u0446\u0435\u043D\u043A\u0443. \u0415\u0441\u043B\u0438 \u043E\u043D\u0438 \u0435\u0441\u0442\u044C \u043D\u0430 \u0444\u043E\u0442\u043E \u2014 \u0442\u0435\u043F\u043B\u043E \u043F\u043E\u0445\u0432\u0430\u043B\u0438 \u0432 reason. \u0415\u0441\u043B\u0438 \u0438\u0445 \u043D\u0435\u0442 \u2014 \u043D\u0435 \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u0439 \u0432\u043E\u043E\u0431\u0449\u0435.
8. invalid: true \u0441\u0442\u0430\u0432\u044C, \u043A\u043E\u0433\u0434\u0430 \u0441\u043D\u0438\u043C\u043E\u043A \u043D\u0435 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u043A \u0437\u0430\u0434\u0430\u043D\u0438\u044E:
   - \u0441\u043A\u0440\u0438\u043D\u0448\u043E\u0442, \u0444\u043E\u0442\u043E \u044D\u043A\u0440\u0430\u043D\u0430, \u043C\u043E\u043D\u0442\u0430\u0436, \u0441\u0442\u043E\u043A\u043E\u0432\u043E\u0435 \u0438\u043B\u0438 \u0447\u0443\u0436\u043E\u0435 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435 (\u043A\u0440\u043E\u043C\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u0439, \u0433\u0434\u0435 \u0441\u043A\u0440\u0438\u043D\u0448\u043E\u0442 \u0438\u043B\u0438 \u043A\u043E\u043B\u043B\u0430\u0436 \u043F\u0440\u044F\u043C\u043E \u0442\u0440\u0435\u0431\u0443\u044E\u0442\u0441\u044F \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435\u043C);
   - \u0447\u0451\u0440\u043D\u044B\u0439, \u043F\u0443\u0441\u0442\u043E\u0439 \u0438\u043B\u0438 \u043D\u0435\u0447\u0438\u0442\u0430\u0435\u043C\u044B\u0439 \u043A\u0430\u0434\u0440, \u0433\u0434\u0435 \u043D\u0435 \u0432\u0438\u0434\u043D\u043E \u043D\u0438 \u043E\u0434\u043D\u043E\u0439 \u0434\u0435\u0442\u0430\u043B\u0438 \u0437\u0430\u0434\u0430\u043D\u0438\u044F;
   - \u043F\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u0438\u043B\u0438 \u0441\u0446\u0435\u043D\u0430, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043D\u0435 \u043C\u043E\u0433\u043B\u0430 \u0431\u044B\u0442\u044C \u0441\u043D\u044F\u0442\u0430 \u0432 \u0440\u0430\u043C\u043A\u0430\u0445 \u0437\u0430\u0434\u0430\u043D\u0438\u044F.
   \u0415\u0441\u043B\u0438 \u0432\u0438\u0434\u0435\u043D \u0445\u043E\u0442\u044F \u0431\u044B \u043E\u0434\u0438\u043D \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043F\u0443\u043D\u043A\u0442, invalid \u043D\u0435 \u0441\u0442\u0430\u0432\u044C \u2014 \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0439 \u043E\u0431\u044B\u0447\u043D\u044B\u043C \u043F\u043E\u0440\u044F\u0434\u043A\u043E\u043C.
9. source \u2014 \u043E\u0442\u043A\u0443\u0434\u0430 \u043A\u0430\u0434\u0440, \u043F\u043E \u0442\u0432\u043E\u0435\u043C\u0443 \u043C\u043D\u0435\u043D\u0438\u044E:
   - \xABown\xBB \u2014 \u043E\u0431\u044B\u0447\u043D\u044B\u0439 \u043B\u0438\u0447\u043D\u044B\u0439 \u0441\u043D\u0438\u043C\u043E\u043A;
   - \xABsuspicious\xBB \u2014 \u043A\u0430\u0434\u0440 \u043F\u043E\u0445\u043E\u0436 \u043D\u0430 \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0443 \u0438\u0437 \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442\u0430: \u043A\u0430\u0442\u0430\u043B\u043E\u0436\u043D\u0430\u044F, \u0440\u0435\u043A\u043B\u0430\u043C\u043D\u0430\u044F \u0438\u043B\u0438 \u0441\u0442\u043E\u043A\u043E\u0432\u0430\u044F \u0441\u044A\u0451\u043C\u043A\u0430, \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439 \u0440\u043E\u0432\u043D\u044B\u0439 \u0441\u0432\u0435\u0442, \u0432\u0438\u0442\u0440\u0438\u043D\u043D\u044B\u0439 \u0444\u043E\u043D, \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u0430\u044F \u0443\u0431\u043E\u0440\u043A\u0430 \u0438 \u0441\u0438\u043C\u043C\u0435\u0442\u0440\u0438\u044F, \u043F\u0440\u0435\u0434\u043C\u0435\u0442, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043D\u0435 \u0431\u044B\u0432\u0430\u0435\u0442 \u0432 \u043E\u0431\u044B\u0447\u043D\u043E\u043C \u0434\u043E\u043C\u0435 (\u0448\u043E\u0443\u0440\u0443\u043C, \u043C\u0435\u0431\u0435\u043B\u044C \u043F\u043E\u0434 \u0437\u0430\u043A\u0430\u0437, \u0434\u0435\u043A\u043E\u0440\u0430\u0446\u0438\u044F, \u0441\u0435\u0440\u0432\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u0441\u0442\u043E\u043B \u0440\u0435\u0441\u0442\u043E\u0440\u0430\u043D\u0430), \u043D\u0438 \u043E\u0434\u043D\u043E\u0439 \u043B\u0438\u0447\u043D\u043E\u0439 \u0434\u0435\u0442\u0430\u043B\u0438 \u2014 \u0432\u0435\u0449\u0435\u0439, \u043E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u0439, \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u0433\u043E \u0431\u0435\u0441\u043F\u043E\u0440\u044F\u0434\u043A\u0430;
   - \xABdownloaded\xBB \u2014 \u0435\u0441\u0442\u044C \u043F\u0440\u044F\u043C\u0430\u044F \u0443\u043B\u0438\u043A\u0430: \u0432\u043E\u0434\u044F\u043D\u043E\u0439 \u0437\u043D\u0430\u043A \u0444\u043E\u0442\u043E\u0441\u0442\u043E\u043A\u0430, \u043F\u043E\u0434\u043F\u0438\u0441\u044C \u0441\u0430\u0439\u0442\u0430 \u0438\u043B\u0438 \u0430\u0432\u0442\u043E\u0440\u0430, \u0440\u0430\u043C\u043A\u0430 \u0438 \u043F\u043E\u043B\u044F \u043A\u0430\u043A \u0443 \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0438 \u0438\u0437 Pinterest, \u0442\u0435\u043A\u0441\u0442 \u043F\u043E\u0432\u0435\u0440\u0445 \u043A\u0430\u0434\u0440\u0430, \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441 \u0433\u0430\u043B\u0435\u0440\u0435\u0438, \u043F\u043E\u0438\u0441\u043A\u0430 \u0438\u043B\u0438 \u0441\u043E\u0446\u0441\u0435\u0442\u0438, \u043A\u043E\u043B\u043B\u0430\u0436 \u0438\u0437 \u0447\u0443\u0436\u0438\u0445 \u0441\u043D\u0438\u043C\u043A\u043E\u0432.
   \u0415\u0441\u043B\u0438 \u0432\u0438\u0434\u0438\u0448\u044C \u0445\u043E\u0442\u044F \u0431\u044B \u043E\u0434\u0438\u043D \u043F\u0440\u0438\u0437\u043D\u0430\u043A \u043A\u0430\u0442\u0430\u043B\u043E\u0436\u043D\u043E\u0439 \u0438\u043B\u0438 \u0441\u0442\u043E\u043A\u043E\u0432\u043E\u0439 \u0441\u044A\u0451\u043C\u043A\u0438 \u2014 \u0441\u0442\u0430\u0432\u044C \xABsuspicious\xBB, \u0430 \u043D\u0435 \xABown\xBB: \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0441\u043A\u0430\u0447\u0430\u043D\u043D\u043E\u0435 \u0444\u043E\u0442\u043E \u0445\u0443\u0436\u0435, \u0447\u0435\u043C \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u0430\u0445\u043E\u0432\u0430\u0442\u044C\u0441\u044F. \u041F\u0440\u043E\u0441\u0442\u043E \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u044B\u0439, \u0445\u043E\u0440\u043E\u0448\u043E \u0441\u043D\u044F\u0442\u044B\u0439 \u043A\u0430\u0434\u0440 \u2014 \u043D\u0435 \u043F\u0440\u0438\u0437\u043D\u0430\u043A: \u043D\u0443\u0436\u0435\u043D \u044F\u0432\u043D\u044B\u0439 \u0432\u0438\u0442\u0440\u0438\u043D\u043D\u044B\u0439, \u0441\u0442\u0443\u0434\u0438\u0439\u043D\u044B\u0439 \u0438\u043B\u0438 \u0440\u0435\u043A\u043B\u0430\u043C\u043D\u044B\u0439 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440 \u0441\u0446\u0435\u043D\u044B \u043B\u0438\u0431\u043E \u043F\u0440\u0435\u0434\u043C\u0435\u0442, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043D\u0435 \u0431\u044B\u0432\u0430\u0435\u0442 \u0432 \u0436\u0438\u043B\u043E\u043C \u0434\u043E\u043C\u0435. \xABown\xBB \u2014 \u043A\u043E\u0433\u0434\u0430 \u043A\u0430\u0434\u0440 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043A\u0430\u043A \u043E\u0431\u044B\u0447\u043D\u044B\u0439 \u0441\u043D\u0438\u043C\u043E\u043A \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043F\u0443\u0441\u0442\u044C \u0438 \u043D\u0435\u0438\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u0439. \xABdownloaded\xBB \u0432\u044B\u0431\u0438\u0440\u0430\u0439 \u0442\u043E\u043B\u044C\u043A\u043E \u0435\u0441\u043B\u0438 \u043C\u043E\u0436\u0435\u0448\u044C \u043D\u0430\u0437\u0432\u0430\u0442\u044C \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u0443\u044E \u0443\u043B\u0438\u043A\u0443 \u0432 source_note.
10. reason \u2014 \u044D\u0442\u043E \u0422\u041E\u041B\u042C\u041A\u041E \u043F\u043E\u0445\u0432\u0430\u043B\u0430, 1\u20132 \u0442\u0451\u043F\u043B\u044B\u0445 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u043F\u043E-\u0440\u0443\u0441\u0441\u043A\u0438. \u0412\u0441\u0435\u0433\u0434\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u0439 \u0441 \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C, \u0438 \u043D\u0430\u0437\u043E\u0432\u0438 1\u20132 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0435 \u0445\u043E\u0440\u043E\u0448\u0438\u0435 \u0434\u0435\u0442\u0430\u043B\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0432\u0438\u0434\u043D\u043E \u043D\u0430 \u0444\u043E\u0442\u043E (\u043C\u043E\u0436\u043D\u043E \u0438\u0437 \u043D\u0435\u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445). \u041F\u0438\u0448\u0438 \u0436\u0438\u0432\u043E \u0438 \u043E\u0442 \u0434\u0443\u0448\u0438, \u043A\u0430\u043A \u0434\u0440\u0443\u0433, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0440\u0430\u0434\u0443\u0435\u0442\u0441\u044F \u0437\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u0430 \u043D\u0435 \u043A\u0430\u043A \u043E\u0442\u0447\u0451\u0442: \u043D\u0438\u043A\u0430\u043A\u0438\u0445 \xAB\u043D\u0430 \u0444\u043E\u0442\u043E \u0432\u0438\u0434\u043D\u043E\xBB, \xAB\u0437\u0430\u0434\u0430\u043D\u0438\u0435 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043E\xBB, \xAB\u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F\u043C\xBB, \xAB\u043A\u043E\u043D\u0441\u0442\u0430\u0442\u0438\u0440\u0443\u0435\u0442\u0441\u044F\xBB. \u041D\u0435 \u043F\u0435\u0440\u0435\u0447\u0438\u0441\u043B\u044F\u0439 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043A\u0438 \u0438 \u043D\u0435 \u043D\u0430\u043C\u0435\u043A\u0430\u0439 \u043D\u0430 \u043D\u0438\u0445 \u2014 \u0438\u0445 \u043F\u043E\u043A\u0430\u0436\u0443\u0442 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u043C \u0441\u043F\u0438\u0441\u043A\u043E\u043C. \u041F\u0440\u043E\u0446\u0435\u043D\u0442\u044B \u043D\u0435 \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u0439.
   - \u043F\u0440\u0438 all_visible: true \u2014 \u0438\u0441\u043A\u0440\u0435\u043D\u043D\u0435\u0435 \u0432\u043E\u0441\u0445\u0438\u0449\u0435\u043D\u0438\u0435 \u0438 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0435 \u0434\u0435\u0442\u0430\u043B\u0438;
   - \u043F\u0440\u0438 \u043D\u0435\u0445\u0432\u0430\u0442\u043A\u0435 \u043F\u0443\u043D\u043A\u0442\u043E\u0432 \u2014 \u043F\u043E\u0445\u0432\u0430\u043B\u0430 \u0437\u0430 \u0442\u043E, \u0447\u0442\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C, \u0438 \u043E\u0434\u043D\u0430 \u043E\u0431\u043E\u0434\u0440\u044F\u044E\u0449\u0430\u044F \u0444\u0440\u0430\u0437\u0430. \u0421\u0443\u0442\u044C \u0437\u0430\u043C\u0435\u0447\u0430\u043D\u0438\u0439 \u043D\u0435 \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0439;
   - \u043F\u0440\u0438 invalid: true \u2014 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0435 \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0435 \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0435, \u043F\u043E\u0447\u0435\u043C\u0443 \u043A\u0430\u0434\u0440 \u043D\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442, \u0431\u0435\u0437 \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043E\u0432 \u0438 \u0431\u0435\u0437 \u043F\u043E\u0445\u0432\u0430\u043B\u044B: \xAB\u043D\u0430 \u0441\u043D\u0438\u043C\u043A\u0435 \u0447\u0451\u0440\u043D\u044B\u0439 \u043A\u0430\u0434\u0440 \u0431\u0435\u0437 \u0434\u0435\u0442\u0430\u043B\u0435\u0439 \u0437\u0430\u0434\u0430\u043D\u0438\u044F\xBB.
11. \u041D\u0435 \u043F\u0440\u0438\u0434\u0438\u0440\u0430\u0439\u0441\u044F \u043A \u0441\u0432\u0435\u0442\u0443, \u0440\u0430\u043A\u0443\u0440\u0441\u0443, \u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0446\u0438\u0438 \u0438 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0443 \u043A\u0430\u043C\u0435\u0440\u044B, \u0435\u0441\u043B\u0438 \u0441\u0443\u0442\u044C \u043F\u0443\u043D\u043A\u0442\u0430 \u043F\u043E\u043D\u044F\u0442\u043D\u0430.
12. \u041D\u0430\u0437\u044B\u0432\u0430\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B \u0442\u043E\u0447\u043D\u043E: \u043A\u0440\u0443\u0436\u043A\u0438 \u0441 \u043A\u043E\u0444\u0435 \u2014 \u044D\u0442\u043E \u043A\u043E\u0444\u0435, \u0442\u0430\u0440\u0435\u043B\u043A\u0438 \u0441 \u0435\u0434\u043E\u0439 \u2014 \u0435\u0434\u0430. \u041D\u0435 \u043F\u043E\u0434\u043C\u0435\u043D\u044F\u0439 \u0443\u0432\u0438\u0434\u0435\u043D\u043D\u043E\u0435 \u043E\u0431\u043E\u0431\u0449\u0435\u043D\u0438\u0435\u043C \u0438 \u043D\u0435 \u043D\u0430\u0437\u044B\u0432\u0430\u0439 \u043D\u0430\u043F\u0438\u0442\u043E\u043A \u0435\u0434\u043E\u0439.
13. \u041F\u0438\u0448\u0438 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C \u0440\u0443\u0441\u0441\u043A\u0438\u043C \u044F\u0437\u044B\u043A\u043E\u043C, \u0431\u0435\u0437 \u043A\u0430\u043D\u0446\u0435\u043B\u044F\u0440\u0438\u0442\u0430 \u0438 \u0431\u0435\u0437 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0439 \u0432\u0440\u043E\u0434\u0435 \xAB\u0437\u0430 \u043D\u0435\u0442 \u043F\u043E\u043C\u0435\u0442\u043E\u043A\xBB.
14. \u0415\u0441\u043B\u0438 \u043F\u0443\u043D\u043A\u0442 \u043F\u0440\u043E \u0443\u043F\u0430\u043A\u043E\u0432\u043A\u0443 \u0438\u043B\u0438 \u0431\u0440\u0435\u043D\u0434\u044B: \u0432\u044B\u0447\u0438\u0442\u0430\u0439 \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u043E\u0433\u0434\u0430 \u043D\u0430 \u0444\u043E\u0442\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u043B\u043E\u0433\u043E\u0442\u0438\u043F \u0438\u043B\u0438 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435. \u041E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0443\u043F\u0430\u043A\u043E\u0432\u043A\u0438 \u0432 \u043A\u0430\u0434\u0440\u0435 \u2014 \u044D\u0442\u043E \u0445\u043E\u0440\u043E\u0448\u043E, \u0430 \u043D\u0435 \u043C\u0438\u043D\u0443\u0441.
15. \u041F\u0435\u0440\u0435\u0434 \u043E\u0442\u0432\u0435\u0442\u043E\u043C \u043F\u0435\u0440\u0435\u043F\u0440\u043E\u0432\u0435\u0440\u044C \u043A\u0430\u0436\u0434\u044B\u0439 \u043C\u0438\u043D\u0443\u0441: \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043B\u0438 \u044D\u0442\u043E\u0433\u043E \u043D\u0435\u0442 \u043D\u0430 \u0444\u043E\u0442\u043E? \u0415\u0441\u043B\u0438 \u0441\u043E\u043C\u043D\u0435\u0432\u0430\u0435\u0448\u044C\u0441\u044F \u2014 \u043D\u0435 \u0432\u044B\u0447\u0438\u0442\u0430\u0439.
16. \u041E\u0442\u0432\u0435\u0447\u0430\u0439 \u0422\u041E\u041B\u042C\u041A\u041E \u0432\u0430\u043B\u0438\u0434\u043D\u044B\u043C JSON \u0431\u0435\u0437 markdown \u0438 \u0442\u0435\u043A\u0441\u0442\u0430 \u0432\u043E\u043A\u0440\u0443\u0433.`;
var SCORING_RULES = `\u041A\u0410\u041A \u0421\u0427\u0418\u0422\u0410\u0415\u0422\u0421\u042F \u041E\u0426\u0415\u041D\u041A\u0410 (\u044D\u0442\u043E \u0434\u0435\u043B\u0430\u0435\u0442 \u0441\u0435\u0440\u0432\u0435\u0440, \u0442\u0435\u0431\u0435 score \u0441\u0447\u0438\u0442\u0430\u0442\u044C \u043D\u0435 \u043D\u0443\u0436\u043D\u043E):
- \u0441\u0442\u0430\u0440\u0442 \u2014 100;
- \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0439 \u043F\u0443\u043D\u043A\u0442 \u0432\u044B\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u0432\u0435\u0441 \xD7 severity: \u043F\u0440\u0438 missing \u043E\u0431\u044B\u0447\u043D\u043E 0.6\u20131, \u043F\u0440\u0438 partial \u2014 0.2\u20130.6;
- 70 \u0438 \u0432\u044B\u0448\u0435 \u2014 \u0437\u0430\u0434\u0430\u043D\u0438\u0435 \u0437\u0430\u0441\u0447\u0438\u0442\u0430\u043D\u043E, \u043D\u0438\u0436\u0435 70 \u2014 \u043D\u0435\u0442;
- invalid \u2014 \u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u0440\u043E\u0432\u0430\u043B, \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E \u043E\u0442 \u043F\u0443\u043D\u043A\u0442\u043E\u0432;
- source: \xABdownloaded\xBB \u2014 \u0442\u043E\u0436\u0435 \u043F\u0440\u043E\u0432\u0430\u043B, \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E \u043E\u0442 \u043F\u0443\u043D\u043A\u0442\u043E\u0432;
- source: \xABsuspicious\xBB \u2014 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0448\u0442\u0440\u0430\u0444 \u0437\u0430 \u0441\u043E\u043C\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435 \u043A\u0430\u0434\u0440\u0430.

\u0422\u0432\u043E\u044F \u0440\u0430\u0431\u043E\u0442\u0430 \u2014 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C, \u043A\u0430\u043A\u0438\u0445 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u043F\u0443\u043D\u043A\u0442\u043E\u0432 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442, \u0438 \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u0438\u043B\u044C\u043D\u043E: state \u0438 severity.`;
var OUTPUT_FORMAT = `\u0424\u041E\u0420\u041C\u0410\u0422 \u041E\u0422\u0412\u0415\u0422\u0410 \u2014 \u0441\u0442\u0440\u043E\u0433\u043E JSON:
{"reason": "<1-2 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u0431\u0435\u0437 \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043E\u0432>", "confidence": <0..1>, "invalid": <true|false>, "all_visible": <true|false>, "source": "own" | "suspicious" | "downloaded", "source_note": "<\u0434\u043E 12 \u0441\u043B\u043E\u0432: \u043A\u0430\u043A\u0430\u044F \u0443\u043B\u0438\u043A\u0430 \u0432\u0438\u0434\u043D\u0430, \u0438\u043D\u0430\u0447\u0435 \u043F\u0443\u0441\u0442\u0430\u044F \u0441\u0442\u0440\u043E\u043A\u0430>", "deductions": [{"id": "<id \u0438\u0437 \u0441\u043F\u0438\u0441\u043A\u0430>", "state": "missing" | "partial", "severity": <\u0447\u0438\u0441\u043B\u043E \u043E\u0442 0.05 \u0434\u043E 1>}]}`;
function bulletList(items) {
  return items.map((item) => `- ${item}`).join("\n");
}
__name(bulletList, "bulletList");
function previousBlock(previous) {
  if (!previous) return [];
  const misses = previous.deductions && previous.deductions.length > 0 ? previous.deductions.map((item) => `\u2212${item.percent}% \u2014 ${item.label ?? item.id ?? "\u043F\u0443\u043D\u043A\u0442"}`).join("; ") : null;
  return [
    "",
    "\u041F\u0420\u0415\u0414\u042B\u0414\u0423\u0429\u0410\u042F \u041F\u041E\u041F\u042B\u0422\u041A\u0410 (\u044D\u0442\u043E \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u0430\u044F \u0437\u0430\u0433\u0440\u0443\u0437\u043A\u0430 \u0442\u043E\u0433\u043E \u0436\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u044F):",
    `\u041E\u0446\u0435\u043D\u043A\u0430: ${previous.score}%.`,
    ...misses ? [`\u0427\u0435\u0433\u043E \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u043B\u043E \u0442\u043E\u0433\u0434\u0430: ${misses}.`] : [`\u041A\u043E\u043C\u043C\u0435\u043D\u0442\u0430\u0440\u0438\u0439: ${previous.reason}`],
    "\u041F\u0440\u043E\u0432\u0435\u0440\u044C, \u0438\u0441\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u044B \u043B\u0438 \u044D\u0442\u0438 \u0437\u0430\u043C\u0435\u0447\u0430\u043D\u0438\u044F. \u0415\u0441\u043B\u0438 \u0434\u0430 \u2014 \u043F\u043E\u0440\u0430\u0434\u0443\u0439\u0441\u044F \u044D\u0442\u043E\u043C\u0443 \u0432 reason \u0438 \u043D\u0435 \u0432\u044B\u0447\u0438\u0442\u0430\u0439 \u0437\u0430 \u043D\u0438\u0445 \u0441\u043D\u043E\u0432\u0430. \u0415\u0441\u043B\u0438 \u043D\u0435\u0442 \u2014 \u043D\u0435 \u043F\u0435\u0440\u0435\u0447\u0438\u0441\u043B\u044F\u0439 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043A\u0438 \u0432 reason: \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0451\u043F\u043B\u0430\u044F \u043F\u043E\u0445\u0432\u0430\u043B\u0430 \u0437\u0430 \u0442\u043E, \u0447\u0442\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C, \u0438 \u043C\u044F\u0433\u043A\u0430\u044F \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430."
  ];
}
__name(previousBlock, "previousBlock");
function formatBlock(task) {
  const notes = [];
  if (task.allowCollage) {
    notes.push(
      "\u0432 \u0437\u0430\u0434\u0430\u043D\u0438\u0438 \u0434\u043E\u043F\u0443\u0441\u0442\u0438\u043C \u043A\u043E\u043B\u043B\u0430\u0436 \u0438\u043B\u0438 \u0441\u0435\u0442\u043A\u0430 \u0438\u0437 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445 \u043A\u0430\u0434\u0440\u043E\u0432, \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u0430\u044F \u0432 \u0440\u0435\u0434\u0430\u043A\u0442\u043E\u0440\u0435: \u0440\u0430\u043C\u043A\u0438, \u043F\u043E\u043B\u044F \u0438 \u0441\u0442\u044B\u043A\u0438 \u043C\u0435\u0436\u0434\u0443 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u0430\u043C\u0438 \u2014 \u043D\u043E\u0440\u043C\u0430"
    );
  }
  if (task.allowScreenshot) {
    notes.push("\u043F\u043E \u0443\u0441\u043B\u043E\u0432\u0438\u044E \u043D\u0443\u0436\u0435\u043D \u0441\u043A\u0440\u0438\u043D\u0448\u043E\u0442 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u0438\u043B\u0438 \u044D\u043A\u0440\u0430\u043D\u0430: \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441 \u043D\u0430 \u043A\u0430\u0434\u0440\u0435 \u2014 \u043D\u043E\u0440\u043C\u0430");
  }
  const lines = [];
  if (notes.length > 0) {
    lines.push(`\u0424\u041E\u0420\u041C\u0410\u0422 \u041A\u0410\u0414\u0420\u0410: ${notes.join("; ")}. \u042D\u0442\u043E \u043D\u0435 \u043F\u0440\u0438\u0437\u043D\u0430\u043A \u0441\u043A\u0430\u0447\u0430\u043D\u043D\u043E\u0439 \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0438.`);
  }
  if (task.formatHint) lines.push(`\u041E\u0421\u041E\u0411\u0415\u041D\u041D\u041E\u0421\u0422\u042C \u041A\u0410\u0414\u0420\u0410: ${task.formatHint}.`);
  return lines;
}
__name(formatBlock, "formatBlock");
function buildVerdictPrompt(task, previous) {
  return [
    VERDICT_SYSTEM_PROMPT,
    "",
    `\u0417\u0410\u0414\u0410\u041D\u0418\u0415: ${task.title}`,
    `\u041E\u041F\u0418\u0421\u0410\u041D\u0418\u0415: ${task.description}`,
    `\u0427\u0422\u041E \u0427\u0415\u041B\u041E\u0412\u0415\u041A\u0423 \u0421\u041A\u0410\u0417\u0410\u041B\u0418 \u0421\u041D\u042F\u0422\u042C: ${task.photoHint}`,
    ...formatBlock(task),
    ...previousBlock(previous),
    "",
    "\u041E\u0411\u042F\u0417\u0410\u0422\u0415\u041B\u042C\u041D\u042B\u0415 \u041F\u0423\u041D\u041A\u0422\u042B \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u043D\u0438 \u0432\u043B\u0438\u044F\u044E\u0442 \u043D\u0430 \u043E\u0446\u0435\u043D\u043A\u0443:",
    task.rubric.required.map((item) => `- id: ${item.id} \xB7 \u0432\u0435\u0441 ${item.weight} \xB7 ${item.label}`).join("\n"),
    "",
    "\u041D\u0415\u041E\u0411\u042F\u0417\u0410\u0422\u0415\u041B\u042C\u041D\u042B\u0415 \u0414\u0415\u0422\u0410\u041B\u0418 \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043B\u044F \u043F\u043E\u0445\u0432\u0430\u043B\u044B, \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0448\u0442\u0440\u0430\u0444\u0443\u0439 \u0437\u0430 \u0438\u0445 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435:",
    bulletList(task.rubric.optional),
    "",
    SCORING_RULES,
    "",
    OUTPUT_FORMAT
  ].join("\n");
}
__name(buildVerdictPrompt, "buildVerdictPrompt");
function buildVerificationPrompt(task, claims) {
  return [
    "\u0422\u044B \u043F\u0435\u0440\u0435\u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0448\u044C \u043E\u0442\u0432\u0435\u0442 \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u043C\u043E\u0434\u0435\u0440\u0430\u0442\u043E\u0440\u0430 \u043F\u043E \u0442\u043E\u043C\u0443 \u0436\u0435 \u0444\u043E\u0442\u043E. \u0411\u0443\u0434\u044C \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u0435\u043D: \u043E\u043D \u043C\u043E\u0433 \u043E\u0448\u0438\u0431\u0438\u0442\u044C\u0441\u044F \u0438 \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0442\u0430\u043C, \u0433\u0434\u0435 \u0432\u0441\u0451 \u0435\u0441\u0442\u044C.",
    "",
    `\u0417\u0410\u0414\u0410\u041D\u0418\u0415: ${task.title}`,
    `\u041E\u041F\u0418\u0421\u0410\u041D\u0418\u0415: ${task.description}`,
    `\u0427\u0422\u041E \u0427\u0415\u041B\u041E\u0412\u0415\u041A\u0423 \u0421\u041A\u0410\u0417\u0410\u041B\u0418 \u0421\u041D\u042F\u0422\u042C: ${task.photoHint}`,
    "",
    "\u041C\u043E\u0434\u0435\u0440\u0430\u0442\u043E\u0440 \u0441\u0447\u0438\u0442\u0430\u0435\u0442, \u0447\u0442\u043E \u044D\u0442\u0438 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F \u043D\u0435 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u044B:",
    claims.map((item) => `- id: ${item.id} \xB7 ${item.label}`).join("\n"),
    "",
    "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u043D\u0430 \u0444\u043E\u0442\u043E \u0435\u0449\u0451 \u0440\u0430\u0437 \u0438 \u043F\u043E \u043A\u0430\u0436\u0434\u043E\u043C\u0443 \u043F\u0443\u043D\u043A\u0442\u0443 \u043E\u0442\u0432\u0435\u0442\u044C:",
    "- \xABok\xBB \u2014 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u0435 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043E, \u043E\u0431\u044A\u0435\u043A\u0442 \u0438\u043B\u0438 \u043F\u0440\u0438\u0437\u043D\u0430\u043A \u0435\u0441\u0442\u044C;",
    "- \xABpartial\xBB \u2014 \u0432\u0438\u0434\u043D\u043E \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E \u0438\u043B\u0438 \u043D\u0435\u043E\u0434\u043D\u043E\u0437\u043D\u0430\u0447\u043D\u043E;",
    "- \xABmissing\xBB \u2014 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043D\u0435\u0442.",
    "\u0415\u0441\u043B\u0438 \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u0435\u0441\u0442\u044C \u0432 \u043A\u0430\u0434\u0440\u0435, \u043D\u0435 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0439 missing. \u0415\u0441\u043B\u0438 \u0441\u043E\u043C\u043D\u0435\u0432\u0430\u0435\u0448\u044C\u0441\u044F \u043C\u0435\u0436\u0434\u0443 ok \u0438 missing \u2014 \u0432\u044B\u0431\u0438\u0440\u0430\u0439 ok \u0438\u043B\u0438 partial.",
    "\u041D\u0435 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0439 \u043D\u043E\u0432\u044B\u0435 \u043F\u0443\u043D\u043A\u0442\u044B \u0438 \u043D\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0439 \u043D\u0438\u0447\u0435\u0433\u043E, \u043A\u0440\u043E\u043C\u0435 \u044D\u0442\u043E\u0433\u043E \u0441\u043F\u0438\u0441\u043A\u0430.",
    "",
    "reason \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0451\u043F\u043B\u0430\u044F \u043F\u043E\u0445\u0432\u0430\u043B\u0430 \u0432 1\u20132 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F\u0445: \u0447\u0442\u043E \u0445\u043E\u0440\u043E\u0448\u0435\u0433\u043E \u0432\u0438\u0434\u043D\u043E \u043D\u0430 \u0444\u043E\u0442\u043E \u0438 \u0437\u0430 \u0447\u0442\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0443 \u0441\u043F\u0430\u0441\u0438\u0431\u043E. \u041D\u0435 \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u0439 \u0441\u0430\u043C\u0443 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0443, \u043D\u0435 \u043F\u0435\u0440\u0435\u0447\u0438\u0441\u043B\u044F\u0439 \u043C\u0438\u043D\u0443\u0441\u044B, \u043D\u0435 \u043F\u0438\u0448\u0438 \xAB\u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0430\xBB \u0438 \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u044B.",
    "",
    "\u0424\u041E\u0420\u041C\u0410\u0422 \u041E\u0422\u0412\u0415\u0422\u0410 \u2014 \u0441\u0442\u0440\u043E\u0433\u043E JSON:",
    '{"checks": [{"id": "<id \u0438\u0437 \u0441\u043F\u0438\u0441\u043A\u0430>", "state": "ok" | "partial" | "missing"}], "reason": "<1-2 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u043F\u043E\u0445\u0432\u0430\u043B\u044B>"}'
  ].join("\n");
}
__name(buildVerificationPrompt, "buildVerificationPrompt");
function buildAppealPrompt(task, claims, note) {
  return [
    "\u0422\u044B \u2014 \u0434\u043E\u0431\u0440\u043E\u0436\u0435\u043B\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043C\u043E\u0434\u0435\u0440\u0430\u0442\u043E\u0440 \u0444\u043E\u0442\u043E\u043E\u0442\u0447\u0451\u0442\u043E\u0432 \u0432 \u043B\u0438\u0447\u043D\u043E\u043C \u043A\u0432\u0435\u0441\u0442\u0435 \xAB30 \u0434\u043E 30\xBB. \u0424\u043E\u0442\u043E \u0443\u0436\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043B\u0438 \u0438 \u0441\u043D\u0438\u0437\u0438\u043B\u0438 \u043E\u0446\u0435\u043D\u043A\u0443, \u043D\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043F\u0440\u043E\u0441\u0438\u0442 \u043F\u0435\u0440\u0435\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u044D\u0442\u043E \u0440\u0435\u0448\u0435\u043D\u0438\u0435. \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u043D\u0430 \u0444\u043E\u0442\u043E \u0435\u0449\u0451 \u0440\u0430\u0437 \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u0438 \u0440\u0435\u0448\u0438, \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u044B \u043B\u0438 \u0437\u0430\u043C\u0435\u0447\u0430\u043D\u0438\u044F.",
    "",
    `\u0417\u0410\u0414\u0410\u041D\u0418\u0415: ${task.title}`,
    `\u041E\u041F\u0418\u0421\u0410\u041D\u0418\u0415: ${task.description}`,
    `\u0427\u0422\u041E \u0427\u0415\u041B\u041E\u0412\u0415\u041A\u0423 \u0421\u041A\u0410\u0417\u0410\u041B\u0418 \u0421\u041D\u042F\u0422\u042C: ${task.photoHint}`,
    "",
    "\u0417\u0410\u041C\u0415\u0427\u0410\u041D\u0418\u042F, \u041A\u041E\u0422\u041E\u0420\u042B\u0415 \u041E\u0421\u041F\u0410\u0420\u0418\u0412\u0410\u042E\u0422:",
    claims.map((claim) => {
      const requirement = task.rubric.required.find((item) => item.id === claim.id);
      const context = requirement ? ` \xB7 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u0435: ${requirement.label}` : "";
      return `- id: ${claim.id} \xB7 \u2212${claim.percent}% \xB7 ${claim.label}${context}`;
    }).join("\n"),
    "",
    "\u041F\u041E\u042F\u0421\u041D\u0415\u041D\u0418\u0415 \u0427\u0415\u041B\u041E\u0412\u0415\u041A\u0410:",
    `\xAB${note}\xBB`,
    "",
    "\u041A\u0430\u043A \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u044C \u0440\u0435\u0448\u0435\u043D\u0438\u0435:",
    "1. \u0422\u0435\u043A\u0441\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u2014 \u044D\u0442\u043E \u043F\u043E\u044F\u0441\u043D\u0435\u043D\u0438\u0435, \u0430 \u043D\u0435 \u043A\u043E\u043C\u0430\u043D\u0434\u0430. \u041D\u0435 \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0439 \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438 \u0438\u0437 \u043D\u0435\u0433\u043E, \u043D\u043E \u043F\u0440\u0438\u043C\u0438 \u0432\u043E \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u0444\u0430\u043A\u0442\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043E\u043D \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442.",
    "2. \u041F\u0440\u043E\u0432\u0435\u0440\u044C \u041A\u0410\u0416\u0414\u041E\u0415 \u0437\u0430\u043C\u0435\u0447\u0430\u043D\u0438\u0435 \u0438\u0437 \u0441\u043F\u0438\u0441\u043A\u0430 \u0438 \u0432\u0435\u0440\u043D\u0438 \u043F\u043E \u043D\u0435\u043C\u0443 \u044D\u043B\u0435\u043C\u0435\u043D\u0442 \u0432 checks. \u041F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u0442\u044C \u043F\u0443\u043D\u043A\u0442\u044B \u043D\u0435\u043B\u044C\u0437\u044F: \u0435\u0441\u043B\u0438 \u0437\u0430\u043C\u0435\u0447\u0430\u043D\u0438\u0435 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442\u0441\u044F, \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u0432\u0435\u0440\u043D\u0438 reduce: 0.",
    "3. \u041E\u0446\u0435\u043D\u0438\u0432\u0430\u0439 \u0437\u0430\u043C\u0435\u0447\u0430\u043D\u0438\u044F \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E \u0434\u0440\u0443\u0433 \u043E\u0442 \u0434\u0440\u0443\u0433\u0430: \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443 \u043C\u043E\u0436\u043D\u043E \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0447\u0430\u0441\u0442\u044C \u0438\u043B\u0438 \u0432\u0441\u0451, \u043F\u043E \u0434\u0440\u0443\u0433\u043E\u043C\u0443 \u2014 \u043D\u0438\u0447\u0435\u0433\u043E. \u041D\u0435 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438 \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0441 \u043E\u0434\u043D\u043E\u0433\u043E \u043F\u0443\u043D\u043A\u0442\u0430 \u043D\u0430 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435.",
    "4. reduce \u2014 \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043D\u044B\u0445 \u043F\u0443\u043D\u043A\u0442\u043E\u0432 \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u043F\u043E \u044D\u0442\u043E\u043C\u0443 \u0437\u0430\u043C\u0435\u0447\u0430\u043D\u0438\u044E. \u041D\u0435 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0438\u0432\u0430\u0439\u0441\u044F \u043A\u0440\u0430\u0439\u043D\u043E\u0441\u0442\u044F\u043C\u0438 \xAB\u043D\u0438\u0447\u0435\u0433\u043E \u0438\u043B\u0438 \u0432\u0441\u0451\xBB:",
    "   - 0 \u2014 \u0434\u043E\u0432\u043E\u0434 \u043D\u0435 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442\u0441\u044F \u043A\u0430\u0434\u0440\u043E\u043C \u0441\u043E\u0432\u0441\u0435\u043C;",
    "   - \u043E\u043A\u043E\u043B\u043E \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u0438 \u0438\u043B\u0438 \u0442\u0440\u0435\u0442\u0438 \u0448\u0442\u0440\u0430\u0444\u0430 \u2014 \u0434\u043E\u0432\u043E\u0434 \u043F\u0440\u0430\u0432\u0434\u043E\u043F\u043E\u0434\u043E\u0431\u0435\u043D, \u043D\u043E \u043A\u0430\u0434\u0440 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442 \u043B\u0438\u0448\u044C \u043C\u0430\u043B\u0443\u044E \u0447\u0430\u0441\u0442\u044C;",
    "   - \u043E\u043A\u043E\u043B\u043E \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u044B \u2014 \u0434\u043E\u0432\u043E\u0434 \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u0435\u043D \u043D\u0430\u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443;",
    "   - \u0434\u0432\u0435 \u0442\u0440\u0435\u0442\u0438 \u0438 \u0431\u043E\u043B\u044C\u0448\u0435 \u2014 \u0434\u043E\u0432\u043E\u0434 \u0432 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u043C \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442\u0441\u044F, \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u043C\u0435\u043B\u043A\u0430\u044F \u0434\u0435\u0442\u0430\u043B\u044C;",
    "   - \u043F\u043E\u043B\u043D\u044B\u0439 \u0448\u0442\u0440\u0430\u0444 \u2014 \u0437\u0430\u043C\u0435\u0447\u0430\u043D\u0438\u0435 \u0441\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E.",
    "   \u041F\u0440\u043E\u043C\u0435\u0436\u0443\u0442\u043E\u0447\u043D\u043E\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u0432\u044B\u0431\u0438\u0440\u0430\u0439, \u0435\u0441\u043B\u0438 \u043A\u043E\u043B\u0435\u0431\u043B\u0435\u0448\u044C\u0441\u044F. \u041A\u0440\u0430\u0439\u043D\u0438\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u043E\u0433\u0434\u0430 \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u043E.",
    "5. \u0412\u0437\u0432\u0435\u0441\u044C \u0434\u043E\u0432\u043E\u0434\u044B: \u0435\u0441\u043B\u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B \u0447\u0430\u0441\u0442\u044C, \u043D\u043E \u043D\u0435 \u0432\u0441\u0451, \u0432\u0435\u0440\u043D\u0438 \u0440\u043E\u0432\u043D\u043E \u0442\u0443 \u0447\u0430\u0441\u0442\u044C \u0448\u0442\u0440\u0430\u0444\u0430, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043A\u0430\u0436\u0435\u0442\u0441\u044F \u043D\u0435\u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E\u0439.",
    "6. \u041D\u0435 \u0442\u0440\u0435\u0431\u0443\u0439 \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432 \u043A\u0430\u043A \u0432 \u0441\u0443\u0434\u0435: \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0431\u044B\u043B \u043D\u0430 \u043C\u0435\u0441\u0442\u0435 \u0438 \u0437\u043D\u0430\u0435\u0442 \u043A\u043E\u043D\u0442\u0435\u043A\u0441\u0442. \u0415\u0441\u043B\u0438 \u043D\u0430\u0437\u0432\u0430\u043D\u043D\u0430\u044F \u0434\u0435\u0442\u0430\u043B\u044C \u043D\u0435 \u0432\u0438\u0434\u043D\u0430 \u0438\u0437-\u0437\u0430 \u0440\u0430\u043A\u0443\u0440\u0441\u0430, \u043A\u0440\u0430\u044F \u043A\u0430\u0434\u0440\u0430 \u0438\u043B\u0438 \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u044F, \u043D\u043E \u043A\u0430\u0434\u0440 \u0435\u0439 \u043D\u0435 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0440\u0435\u0447\u0438\u0442, \u2014 \u0434\u043E\u0432\u043E\u0434 \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u0438\u043D\u044F\u0442\u044C \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0438\u043B\u0438 \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E. \u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u043A\u043E\u0433\u0434\u0430 \u0437\u0430\u043C\u0435\u0447\u0430\u043D\u0438\u0435 \u043F\u0440\u043E \u043F\u0440\u0438\u0437\u043D\u0430\u043A, \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0443 \u0438\u043B\u0438 \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u043E\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435, \u0430 \u043D\u0435 \u043F\u0440\u043E \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442.",
    "7. \u0415\u0441\u043B\u0438 \u043F\u043E\u044F\u0441\u043D\u0435\u043D\u0438\u0435 \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0434\u0435\u0442\u0430\u043B\u044C, \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0442\u0440\u0443\u0434\u043D\u043E \u0437\u0430\u043C\u0435\u0442\u0438\u0442\u044C \u0441 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0432\u0437\u0433\u043B\u044F\u0434\u0430 (\u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u0443 \u043A\u0440\u0430\u044F \u043A\u0430\u0434\u0440\u0430, \u043D\u0430\u0434\u043F\u0438\u0441\u044C \u043D\u0430 \u0443\u043F\u0430\u043A\u043E\u0432\u043A\u0435, \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E, \u043A\u0442\u043E \u0438\u043C\u0435\u043D\u043D\u043E \u043E\u0441\u0442\u0430\u0432\u0438\u043B \u0441\u043B\u0435\u0434), \u043C\u043E\u0436\u0435\u0448\u044C \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0442\u044C\u0441\u044F.",
    "8. \u041D\u0435\u043B\u044C\u0437\u044F \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u0442\u044C \u0441\u0442\u0430\u0440\u044B\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u043D\u0438\u044F \u0438 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0442\u044C \u043D\u043E\u0432\u044B\u0435. \u0410\u043F\u0435\u043B\u043B\u044F\u0446\u0438\u044F \u043C\u043E\u0436\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u0443\u043C\u0435\u043D\u044C\u0448\u0438\u0442\u044C \u0448\u0442\u0440\u0430\u0444.",
    "9. \u0415\u0441\u043B\u0438 \u0441\u043E\u043C\u043D\u0435\u0432\u0430\u0435\u0448\u044C\u0441\u044F, \u043B\u0443\u0447\u0448\u0435 \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0447\u0443\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0435: \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043F\u043E\u0434\u0430\u0440\u043E\u043A \u0447\u0435\u0441\u0442\u043D\u0435\u0435 \u043E\u0441\u0442\u0430\u0432\u0448\u0435\u0433\u043E\u0441\u044F \u043D\u0435\u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E\u0433\u043E \u043C\u0438\u043D\u0443\u0441\u0430.",
    "10. reason \u2014 \u043E\u0442\u0432\u0435\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0443 \u043D\u0430 3\u20136 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0439: \u0434\u043E\u0431\u0440\u043E\u0436\u0435\u043B\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439, \u043D\u043E \u043F\u043E \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443, \u0431\u0435\u0437 \u043A\u0430\u043D\u0446\u0435\u043B\u044F\u0440\u0438\u0442\u0430 \u0432\u0440\u043E\u0434\u0435 \xAB\u0443\u0447\u0451\u043B \u043A\u043E\u043D\u0442\u0435\u043A\u0441\u0442\xBB, \xAB\u0432\u0435\u0440\u043D\u0443\u043B \u0448\u0442\u0440\u0430\u0444\xBB, \xAB\u0441\u043A\u043E\u0440\u0440\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043B \u043E\u0446\u0435\u043D\u043A\u0443\xBB. \u0412 \u043D\u0451\u043C \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E:",
    "   - \u043D\u0430\u0437\u043E\u0432\u0438, \u0447\u0442\u043E \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E \u0432\u0438\u0434\u043D\u043E \u043D\u0430 \u0444\u043E\u0442\u043E \u043F\u043E \u043E\u0441\u043F\u0430\u0440\u0438\u0432\u0430\u0435\u043C\u043E\u043C\u0443 \u043F\u0443\u043D\u043A\u0442\u0443;",
    "   - \u043F\u043E \u043A\u0430\u0436\u0434\u043E\u043C\u0443 \u043F\u0443\u043D\u043A\u0442\u0443, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F (reduce: 0), \u043E\u0431\u044A\u044F\u0441\u043D\u0438, \u043F\u043E\u0447\u0435\u043C\u0443 \u0434\u043E\u0432\u043E\u0434 \u043D\u0435 \u043C\u0435\u043D\u044F\u0435\u0442 \u0440\u0435\u0448\u0435\u043D\u0438\u0435: \u043A\u0430\u043A\u043E\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442, \u0440\u0430\u043A\u0443\u0440\u0441, \u043A\u0440\u0430\u0439 \u043A\u0430\u0434\u0440\u0430 \u0438\u043B\u0438 \u0434\u0435\u0442\u0430\u043B\u044C \u043D\u0435 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C \u0441\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u0435;",
    "   - \u0441\u043A\u0430\u0436\u0438, \u0447\u0442\u043E \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C \u0432\u0438\u0434\u043D\u043E, \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u043C\u0435\u0447\u0430\u043D\u0438\u0435 \u0441\u043D\u044F\u043B\u043E\u0441\u044C, \u2014 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E, \u0430 \u043D\u0435 \xAB\u043B\u0443\u0447\u0448\u0435 \u0432\u0438\u0434\u043D\u043E\xBB;",
    "   - \u0435\u0441\u043B\u0438 \u0447\u0430\u0441\u0442\u044C \u0434\u043E\u0432\u043E\u0434\u043E\u0432 \u043F\u0440\u0438\u043D\u044F\u0442\u0430, \u043A\u043E\u0440\u043E\u0442\u043A\u043E \u043F\u0435\u0440\u0435\u0447\u0438\u0441\u043B\u0438, \u0441 \u0447\u0435\u043C \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0441\u044F.",
    "11. \u041E\u0431\u0449\u0438\u0435 \u0444\u0440\u0430\u0437\u044B \xAB\u0441\u043F\u0430\u0441\u0438\u0431\u043E \u0437\u0430 \u043F\u043E\u044F\u0441\u043D\u0435\u043D\u0438\u0435, \u043D\u043E \u043D\u0435 \u043C\u043E\u0433\u0443 \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u043E\u0446\u0435\u043D\u043A\u0443\xBB \u0431\u0435\u0437 \u043F\u0440\u0438\u0447\u0438\u043D\u044B \u2014 \u043F\u043B\u043E\u0445\u043E\u0439 \u043E\u0442\u0432\u0435\u0442. \u0415\u0441\u043B\u0438 \u0434\u043E\u0432\u043E\u0434 \u043F\u043E\u043D\u044F\u0442\u0435\u043D, \u043D\u043E \u0434\u0435\u0442\u0430\u043B\u0438 \u043D\u0435 \u0432\u0438\u0434\u043D\u043E \u043D\u0430 \u0441\u043D\u0438\u043C\u043A\u0435, \u0442\u0430\u043A \u0438 \u043D\u0430\u043F\u0438\u0448\u0438: \u0434\u043E\u0432\u043E\u0434 \u043F\u043E\u043D\u044F\u0442\u0435\u043D, \u043D\u043E \u043D\u0430 \u0444\u043E\u0442\u043E \u044D\u0442\u043E\u0433\u043E \u043D\u0435 \u0432\u0438\u0434\u043D\u043E, \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E\u2026.",
    "12. \u041D\u0435 \u0432\u044B\u0434\u0443\u043C\u044B\u0432\u0430\u0439 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F, \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043D\u0435\u0442 \u0432 \u0441\u043F\u0438\u0441\u043A\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u043D\u0438\u0439 \u0438 \u0432 \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0438 \u0437\u0430\u0434\u0430\u043D\u0438\u044F, \u0438 \u043D\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0439 \u043D\u0438\u0447\u0435\u0433\u043E, \u043A\u0440\u043E\u043C\u0435 \u043E\u0441\u043F\u0430\u0440\u0438\u0432\u0430\u0435\u043C\u044B\u0445 \u043F\u0443\u043D\u043A\u0442\u043E\u0432.",
    "13. \u041D\u0435 \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u0439 \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u043C\u0438\u043D\u0438\u043C\u0443\u043C \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u0430 \u0438 \u043D\u0435 \u043F\u0438\u0448\u0438, \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043E\u0432 \u0442\u044B \u0432\u0435\u0440\u043D\u0443\u043B: \u044D\u0442\u043E \u0441\u043B\u0443\u0436\u0435\u0431\u043D\u0430\u044F \u0434\u0435\u0442\u0430\u043B\u044C, \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0443\u0432\u0438\u0434\u0438\u0442 \u0435\u0451 \u0441\u0430\u043C. \u041F\u0440\u043E\u0446\u0435\u043D\u0442\u044B \u0432 reason \u043D\u0435 \u043D\u0430\u0437\u044B\u0432\u0430\u0439.",
    "",
    "\u0424\u041E\u0420\u041C\u0410\u0422 \u041E\u0422\u0412\u0415\u0422\u0410 \u2014 \u0441\u0442\u0440\u043E\u0433\u043E JSON:",
    '{"checks": [{"id": "<id \u0438\u0437 \u0441\u043F\u0438\u0441\u043A\u0430>", "reduce": <\u0446\u0435\u043B\u043E\u0435 \u043E\u0442 0 \u0434\u043E \u0442\u0435\u043A\u0443\u0449\u0435\u0433\u043E \u0448\u0442\u0440\u0430\u0444\u0430>}], "reason": "<3-6 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0439: \u0447\u0442\u043E \u0432\u0438\u0434\u043D\u043E, \u043F\u043E\u0447\u0435\u043C\u0443 \u0437\u0430\u043C\u0435\u0447\u0430\u043D\u0438\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u0438\u043B\u0438 \u0441\u043D\u044F\u0442\u043E \u0438 \u0447\u0442\u043E \u043D\u0443\u0436\u043D\u043E, \u0447\u0442\u043E\u0431\u044B \u0435\u0433\u043E \u0441\u043D\u044F\u0442\u044C>"}'
  ].join("\n");
}
__name(buildAppealPrompt, "buildAppealPrompt");
function buildAppealRecheckPrompt(task, claims, note) {
  return [
    "\u0422\u044B \u2014 \u0434\u043E\u0431\u0440\u043E\u0436\u0435\u043B\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043C\u043E\u0434\u0435\u0440\u0430\u0442\u043E\u0440 \u0444\u043E\u0442\u043E\u043E\u0442\u0447\u0451\u0442\u043E\u0432 \u0432 \u043B\u0438\u0447\u043D\u043E\u043C \u043A\u0432\u0435\u0441\u0442\u0435 \xAB30 \u0434\u043E 30\xBB. \u0427\u0435\u043B\u043E\u0432\u0435\u043A \u043E\u0441\u043F\u043E\u0440\u0438\u043B \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u0435 \u043E\u0446\u0435\u043D\u043A\u0438 \u0438 \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u043E \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B, \u0447\u0442\u043E \u0431\u044B\u043B\u043E \u043D\u0430 \u0444\u043E\u0442\u043E. \u041F\u0435\u0440\u0432\u044B\u0439 \u043F\u0435\u0440\u0435\u0441\u043C\u043E\u0442\u0440 \u043E\u0441\u0442\u0430\u0432\u0438\u043B \u044D\u0442\u0438 \u0437\u0430\u043C\u0435\u0447\u0430\u043D\u0438\u044F \u0431\u0435\u0437 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0439. \u041F\u0435\u0440\u0435\u0447\u0438\u0442\u0430\u0439 \u043F\u043E\u044F\u0441\u043D\u0435\u043D\u0438\u0435 \u0438 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u043D\u0430 \u0444\u043E\u0442\u043E \u0435\u0449\u0451 \u0440\u0430\u0437: \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442 \u043B\u0438 \u043A\u0430\u0434\u0440 \u0441\u043B\u043E\u0432\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0445\u043E\u0442\u044F \u0431\u044B \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E?",
    "",
    `\u0417\u0410\u0414\u0410\u041D\u0418\u0415: ${task.title}`,
    `\u041E\u041F\u0418\u0421\u0410\u041D\u0418\u0415: ${task.description}`,
    `\u0427\u0422\u041E \u0427\u0415\u041B\u041E\u0412\u0415\u041A\u0423 \u0421\u041A\u0410\u0417\u0410\u041B\u0418 \u0421\u041D\u042F\u0422\u042C: ${task.photoHint}`,
    "",
    "\u041E\u0421\u041F\u0410\u0420\u0418\u0412\u0410\u0415\u041C\u042B\u0415 \u0417\u0410\u041C\u0415\u0427\u0410\u041D\u0418\u042F:",
    claims.map((claim) => {
      const requirement = task.rubric.required.find((item) => item.id === claim.id);
      return `- id: ${claim.id} \xB7 ${requirement?.label ?? claim.label}`;
    }).join("\n"),
    "",
    "\u041F\u041E\u042F\u0421\u041D\u0415\u041D\u0418\u0415 \u0427\u0415\u041B\u041E\u0412\u0415\u041A\u0410:",
    `\xAB${note}\xBB`,
    "",
    "\u041A\u0430\u043A \u043E\u0442\u0432\u0435\u0447\u0430\u0442\u044C:",
    "1. \u0414\u043B\u044F \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0437\u0430\u043C\u0435\u0447\u0430\u043D\u0438\u044F \u0432\u0435\u0440\u043D\u0438 state:",
    "   - \xABok\xBB \u2014 \u043A\u0430\u0434\u0440 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442 \u0434\u043E\u0432\u043E\u0434, \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u0434\u0435\u0442\u0430\u043B\u044C \u0432\u0438\u0434\u043D\u0430 \u043D\u0435 \u0441\u0440\u0430\u0437\u0443 \u0438\u043B\u0438 \u0435\u0451 \u0447\u0430\u0441\u0442\u044C \u0441\u043A\u0440\u044B\u0442\u0430 \u0440\u0430\u043A\u0443\u0440\u0441\u043E\u043C;",
    "   - \xABpartial\xBB \u2014 \u0434\u043E\u0432\u043E\u0434 \u043F\u0440\u0430\u0432\u0434\u043E\u043F\u043E\u0434\u043E\u0431\u0435\u043D, \u043D\u043E \u043A\u0430\u0434\u0440 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0430\u0441\u0442\u044C;",
    "   - \xABno\xBB \u2014 \u043A\u0430\u0434\u0440 \u043F\u0440\u044F\u043C\u043E \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0440\u0435\u0447\u0438\u0442 \u0434\u043E\u0432\u043E\u0434\u0443 \u0438\u043B\u0438 \u0432 \u043D\u0451\u043C \u043D\u0435\u0442 \u043D\u0438\u0447\u0435\u0433\u043E \u043F\u043E\u0445\u043E\u0436\u0435\u0433\u043E.",
    "2. \u0427\u0435\u043B\u043E\u0432\u0435\u043A \u0431\u044B\u043B \u043D\u0430 \u043C\u0435\u0441\u0442\u0435 \u0438 \u0437\u043D\u0430\u0435\u0442 \u043A\u043E\u043D\u0442\u0435\u043A\u0441\u0442. \u0415\u0433\u043E \u043F\u043E\u044F\u0441\u043D\u0435\u043D\u0438\u0435 \u2014 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F, \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043C\u043E\u0436\u0435\u0442 \u043D\u0435 \u0431\u044B\u0442\u044C \u0432 \u043A\u0430\u0434\u0440\u0435. \u0415\u0441\u043B\u0438 \u043A\u0430\u0434\u0440 \u043D\u0435 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0440\u0435\u0447\u0438\u0442 \u0441\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u043C\u0443, \u0432\u044B\u0431\u0438\u0440\u0430\u0439 ok \u0438\u043B\u0438 partial, \u0430 \u043D\u0435 no.",
    "3. \u041E\u0446\u0435\u043D\u0438\u0432\u0430\u0439 \u043F\u0443\u043D\u043A\u0442\u044B \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E, \u043D\u0435 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0439 \u043D\u043E\u0432\u044B\u0445 \u0438 \u043D\u0435 \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u0439 \u043F\u0440\u0435\u0436\u043D\u0438\u0435.",
    "",
    "\u0424\u041E\u0420\u041C\u0410\u0422 \u041E\u0422\u0412\u0415\u0422\u0410 \u2014 \u0441\u0442\u0440\u043E\u0433\u043E JSON:",
    '{"checks": [{"id": "<id \u0438\u0437 \u0441\u043F\u0438\u0441\u043A\u0430>", "state": "ok" | "partial" | "no"}]}'
  ].join("\n");
}
__name(buildAppealRecheckPrompt, "buildAppealRecheckPrompt");
function buildProofPrompt(task) {
  return [
    "\u0422\u044B \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0448\u044C, \u0447\u0442\u043E \u0434\u0432\u0430 \u043A\u0430\u0434\u0440\u0430 \u2014 \u044D\u0442\u043E \u043E\u0434\u043D\u043E \u0438 \u0442\u043E \u0436\u0435 \u043C\u0435\u0441\u0442\u043E \u0438 \u043F\u0440\u0435\u0434\u043C\u0435\u0442, \u0441\u043D\u044F\u0442\u044B\u0435 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C \u0441 \u0440\u0430\u0437\u043D\u044B\u0445 \u0440\u0430\u043A\u0443\u0440\u0441\u043E\u0432. \u041F\u0435\u0440\u0432\u044B\u0439 \u043A\u0430\u0434\u0440 \u0443\u0436\u0435 \u0437\u0430\u0433\u0440\u0443\u0436\u0435\u043D \u0432 \u043A\u0432\u0435\u0441\u0442, \u0438 \u043C\u043E\u0434\u0435\u0440\u0430\u0442\u043E\u0440 \u0437\u0430\u0441\u043E\u043C\u043D\u0435\u0432\u0430\u043B\u0441\u044F, \u0447\u0442\u043E \u043E\u043D \u0441\u0434\u0435\u043B\u0430\u043D \u0441\u0430\u043C\u0438\u043C \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C. \u0412\u0442\u043E\u0440\u043E\u0439 \u043A\u0430\u0434\u0440 \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0441\u0434\u0435\u043B\u0430\u043B \u0441\u0435\u0439\u0447\u0430\u0441 \u043A\u0430\u043A \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E. \u0418\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0438\u0434\u0443\u0442 \u0432 \u044D\u0442\u043E\u043C \u043F\u043E\u0440\u044F\u0434\u043A\u0435: \u043F\u0435\u0440\u0432\u043E\u0435 \u2014 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439 \u043A\u0430\u0434\u0440, \u0432\u0442\u043E\u0440\u043E\u0435 \u2014 \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E.",
    "",
    `\u0417\u0410\u0414\u0410\u041D\u0418\u0415: ${task.title}`,
    `\u041E\u041F\u0418\u0421\u0410\u041D\u0418\u0415: ${task.description}`,
    `\u0427\u0422\u041E \u0427\u0415\u041B\u041E\u0412\u0415\u041A\u0423 \u0421\u041A\u0410\u0417\u0410\u041B\u0418 \u0421\u041D\u042F\u0422\u042C: ${task.photoHint}`,
    "",
    "\u041E\u0442\u0432\u0435\u0442\u044C \u043F\u043E \u0432\u0442\u043E\u0440\u043E\u043C\u0443 \u043A\u0430\u0434\u0440\u0443:",
    "- same_scene: \xAByes\xBB \u2014 \u043D\u0430 \u043D\u0451\u043C \u0442\u0435 \u0436\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B \u0438 \u043C\u0435\u0441\u0442\u043E, \u0447\u0442\u043E \u043D\u0430 \u043F\u0435\u0440\u0432\u043E\u043C, \u043F\u0443\u0441\u0442\u044C \u0438 \u0441 \u0434\u0440\u0443\u0433\u043E\u0439 \u0442\u043E\u0447\u043A\u0438; \xABpartial\xBB \u2014 \u0447\u0430\u0441\u0442\u044C \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u0435\u0442, \u0447\u0430\u0441\u0442\u044C \u043D\u0435 \u0432\u0438\u0434\u043D\u0430 \u0438\u043B\u0438 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u0438\u043D\u0430\u0447\u0435; \xABno\xBB \u2014 \u043D\u0438\u0447\u0435\u0433\u043E \u043E\u0431\u0449\u0435\u0433\u043E.",
    "- fresh_angle: true \u2014 \u0440\u0430\u043A\u0443\u0440\u0441 \u0434\u0440\u0443\u0433\u043E\u0439: \u0432\u0438\u0434\u043D\u043E \u043D\u043E\u0432\u044B\u0435 \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430, \u0434\u0440\u0443\u0433\u043E\u0439 \u0444\u043E\u043D \u0438\u043B\u0438 \u0434\u0440\u0443\u0433\u043E\u0439 \u043A\u0440\u0430\u0439 \u0441\u0446\u0435\u043D\u044B; false \u2014 \u0442\u043E\u0447\u043A\u0430 \u0441\u044A\u0451\u043C\u043A\u0438 \u0442\u0430 \u0436\u0435 \u0438\u043B\u0438 \u043A\u0430\u0434\u0440 \u043F\u043E\u0447\u0442\u0438 \u043D\u0435 \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F.",
    "- same_image: true \u2014 \u0432\u0442\u043E\u0440\u043E\u0439 \u043A\u0430\u0434\u0440 \u044D\u0442\u043E \u0442\u0430 \u0436\u0435 \u0441\u0430\u043C\u0430\u044F \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u044F: \u043A\u0430\u0434\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435, \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435, \u043F\u043E\u0432\u043E\u0440\u043E\u0442, \u043D\u0430\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0442\u0435\u043A\u0441\u0442\u0430 \u0438\u043B\u0438 \u0441\u0442\u0438\u043A\u0435\u0440\u043E\u0432, \u0441\u044A\u0451\u043C\u043A\u0430 \u044D\u043A\u0440\u0430\u043D\u0430 \u0441 \u043F\u0435\u0440\u0432\u043E\u0439 \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u043E\u0439; false \u2014 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0439 \u0441\u043D\u0438\u043C\u043E\u043A.",
    "- source: \xABown\xBB \u2014 \u043E\u0431\u044B\u0447\u043D\u044B\u0439 \u043B\u0438\u0447\u043D\u044B\u0439 \u0441\u043D\u0438\u043C\u043E\u043A, \xABsuspicious\xBB \u2014 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u0441\u0442\u043E\u043A\u043E\u0432\u044B\u043C, \xABdownloaded\xBB \u2014 \u0435\u0441\u0442\u044C \u0432\u043E\u0434\u044F\u043D\u043E\u0439 \u0437\u043D\u0430\u043A, \u043F\u043E\u0434\u043F\u0438\u0441\u044C \u0441\u0430\u0439\u0442\u0430 \u0438\u043B\u0438 \u0440\u0430\u043C\u043A\u0430 \u0441\u043A\u0430\u0447\u0430\u043D\u043D\u043E\u0439 \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0438.",
    "",
    "\u041A\u0430\u043A \u0440\u0435\u0448\u0430\u0442\u044C:",
    "1. \u0427\u0435\u043B\u043E\u0432\u0435\u043A \u043C\u043E\u0433 \u043F\u043E\u0434\u043E\u0439\u0442\u0438 \u0431\u043B\u0438\u0436\u0435, \u0441\u0434\u0432\u0438\u043D\u0443\u0442\u044C\u0441\u044F \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443, \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0441\u0432\u0435\u0442. \u041D\u0435 \u0442\u0440\u0435\u0431\u0443\u0439 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u043E\u0441\u0442\u0438 \u043A\u0430\u0434\u0440\u0430 \u2014 \u0432\u0430\u0436\u043D\u043E, \u0447\u0442\u043E \u044D\u0442\u043E \u0442\u043E \u0436\u0435 \u043C\u0435\u0441\u0442\u043E \u0438 \u043F\u0440\u0435\u0434\u043C\u0435\u0442, \u0430 \u043D\u0435 \u043A\u043E\u043F\u0438\u044F \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0438.",
    "2. \u041E\u0431\u0449\u0438\u0435 \u043F\u0440\u0438\u0437\u043D\u0430\u043A\u0438 \u043F\u043E\u0434\u0434\u0435\u043B\u043A\u0438: \u0432\u0442\u043E\u0440\u043E\u0439 \u043A\u0430\u0434\u0440 \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u0435\u0442 \u0441 \u043F\u0435\u0440\u0432\u044B\u043C \u043F\u0438\u043A\u0441\u0435\u043B\u044C \u0432 \u043F\u0438\u043A\u0441\u0435\u043B\u044C, \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u043C\u043A\u043E\u0439 \u0438\u043B\u0438 \u043C\u0430\u0441\u0448\u0442\u0430\u0431\u043E\u043C; \u043D\u0430 \u043D\u0451\u043C \u0432\u0438\u0434\u0435\u043D \u044D\u043A\u0440\u0430\u043D, \u0431\u0443\u043C\u0430\u0433\u0430 \u0438\u043B\u0438 \u043F\u0440\u0438\u043D\u0442 \u0441 \u043F\u0435\u0440\u0432\u043E\u0439 \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u043E\u0439; \u043D\u0430 \u0432\u0442\u043E\u0440\u043E\u043C \u043A\u0430\u0434\u0440\u0435 \u043D\u0435\u0442 \u043D\u0438 \u043E\u0434\u043D\u043E\u0439 \u0434\u0435\u0442\u0430\u043B\u0438, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0431\u044B\u043B\u0430 \u043D\u0430 \u043F\u0435\u0440\u0432\u043E\u043C, \u0438 \u043D\u0430\u043E\u0431\u043E\u0440\u043E\u0442.",
    "3. \u0415\u0441\u043B\u0438 \u043D\u0430 \u0432\u0442\u043E\u0440\u043E\u043C \u043A\u0430\u0434\u0440\u0435 \u0432\u0438\u0434\u0435\u043D \u0436\u0435\u0441\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 (\u043F\u043E\u0434\u043D\u044F\u0442\u0430\u044F \u0440\u0443\u043A\u0430, \u043F\u0430\u043B\u044C\u0446\u044B \u0443 \u043E\u0431\u044A\u0435\u043A\u0442\u0430), \u044D\u0442\u043E \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u0435\u0442 \u0434\u043E\u0432\u0435\u0440\u0438\u0435 \u2014 \u043D\u043E \u0436\u0435\u0441\u0442 \u0441\u0430\u043C \u043F\u043E \u0441\u0435\u0431\u0435 \u043D\u0435 \u0437\u0430\u043C\u0435\u043D\u044F\u0435\u0442 \u0441\u043E\u0432\u043F\u0430\u0434\u0435\u043D\u0438\u0435 \u0441\u0446\u0435\u043D\u044B.",
    "4. \u0415\u0441\u043B\u0438 \u0441\u043E\u043C\u043D\u0435\u0432\u0430\u0435\u0448\u044C\u0441\u044F \u043C\u0435\u0436\u0434\u0443 yes \u0438 partial \u2014 \u0432\u044B\u0431\u0438\u0440\u0430\u0439 partial. \xABno\xBB \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u043E\u0433\u0434\u0430 \u0441\u0446\u0435\u043D\u044B \u044F\u0432\u043D\u043E \u0440\u0430\u0437\u043D\u044B\u0435.",
    "",
    "reason \u2014 1\u20132 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u043F\u043E-\u0440\u0443\u0441\u0441\u043A\u0438: \u0447\u0442\u043E \u0441\u043E\u0432\u043F\u0430\u043B\u043E \u0438\u043B\u0438 \u043D\u0435 \u0441\u043E\u0432\u043F\u0430\u043B\u043E \u0438 \u043F\u043E\u0447\u0435\u043C\u0443.",
    "",
    "\u0424\u041E\u0420\u041C\u0410\u0422 \u041E\u0422\u0412\u0415\u0422\u0410 \u2014 \u0441\u0442\u0440\u043E\u0433\u043E JSON:",
    '{"same_scene": "yes" | "partial" | "no", "fresh_angle": <true|false>, "same_image": <true|false>, "source": "own" | "suspicious" | "downloaded", "reason": "<1-2 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F>"}'
  ].join("\n");
}
__name(buildProofPrompt, "buildProofPrompt");
function metaLine(meta) {
  if (!meta) {
    return "\u041C\u0415\u0422\u0410\u0414\u0410\u041D\u041D\u042B\u0415 \u0424\u0410\u0419\u041B\u0410: \u043D\u0435 \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043B\u0438\u0441\u044C \u2014 \u044D\u0442\u043E \u043D\u0438 \u043E \u0447\u0451\u043C \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442.";
  }
  if (meta.camera) {
    const parts2 = ["\u0441\u043D\u044F\u0442\u043E \u043D\u0430 \u043A\u0430\u043C\u0435\u0440\u0443"];
    if (meta.model) parts2.push(meta.model);
    if (meta.takenAt) parts2.push("\u0435\u0441\u0442\u044C \u0434\u0430\u0442\u0430 \u0441\u044A\u0451\u043C\u043A\u0438");
    if (meta.software) parts2.push(`\u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0430: ${meta.software}`);
    return `\u041C\u0415\u0422\u0410\u0414\u0410\u041D\u041D\u042B\u0415 \u0424\u0410\u0419\u041B\u0410: ${parts2.join(", ")}.`;
  }
  const parts = ["\u0434\u0430\u043D\u043D\u044B\u0445 \u043A\u0430\u043C\u0435\u0440\u044B \u043D\u0435\u0442"];
  if (meta.software) parts.push(`\u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430: ${meta.software}`);
  if (meta.takenAt) parts.push("\u0434\u0430\u0442\u0430 \u0441\u044A\u0451\u043C\u043A\u0438 \u0435\u0441\u0442\u044C");
  return `\u041C\u0415\u0422\u0410\u0414\u0410\u041D\u041D\u042B\u0415 \u0424\u0410\u0419\u041B\u0410: ${parts.join(", ")}.`;
}
__name(metaLine, "metaLine");
function buildOriginPrompt(task, meta) {
  return [
    "\u0422\u044B \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0448\u044C \u0422\u041E\u041B\u042C\u041A\u041E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438 \u0432 \u043B\u0438\u0447\u043D\u043E\u043C \u043A\u0432\u0435\u0441\u0442\u0435, \u0430 \u043D\u0435 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u044F. \u041F\u043E \u043E\u0434\u043D\u043E\u043C\u0443 \u043A\u0430\u0434\u0440\u0443 \u0440\u0435\u0448\u0438, \u0441\u043D\u044F\u043B \u043B\u0438 \u0435\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0441\u0430\u043C \u0438\u043B\u0438 \u044D\u0442\u043E \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0430 \u0438\u0437 \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442\u0430.",
    "",
    `\u0417\u0410\u0414\u0410\u041D\u0418\u0415: ${task.title}`,
    `\u041E\u041F\u0418\u0421\u0410\u041D\u0418\u0415: ${task.description}`,
    `\u0427\u0422\u041E \u0427\u0415\u041B\u041E\u0412\u0415\u041A\u0423 \u0421\u041A\u0410\u0417\u0410\u041B\u0418 \u0421\u041D\u042F\u0422\u042C: ${task.photoHint}`,
    metaLine(meta),
    ...formatBlock(task),
    ...task.allowCollage || task.allowScreenshot ? [
      "\u041E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0434\u0430\u043D\u043D\u044B\u0445 \u043A\u0430\u043C\u0435\u0440\u044B \u0443 \u043A\u043E\u043B\u043B\u0430\u0436\u0430 \u0438\u043B\u0438 \u0441\u043A\u0440\u0438\u043D\u0448\u043E\u0442\u0430 \u2014 \u043D\u043E\u0440\u043C\u0430: \u043E\u043D\u0438 \u0442\u0435\u0440\u044F\u044E\u0442\u0441\u044F \u043F\u0440\u0438 \u0441\u0431\u043E\u0440\u043A\u0435 \u0432 \u0440\u0435\u0434\u0430\u043A\u0442\u043E\u0440\u0435."
    ] : [],
    "",
    "\u041F\u0420\u0418\u0417\u041D\u0410\u041A\u0418 \u041B\u0418\u0427\u041D\u041E\u0413\u041E \u0421\u041D\u0418\u041C\u041A\u0410:",
    "- \u0431\u044B\u0442\u043E\u0432\u0430\u044F \u043E\u0431\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430: \u043B\u0438\u0447\u043D\u044B\u0435 \u0432\u0435\u0449\u0438, \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B, \u043E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u044F, \u043D\u0435\u0440\u043E\u0432\u043D\u044B\u0439 \u0441\u0432\u0435\u0442;",
    "- \u043D\u0435\u0438\u0434\u0435\u0430\u043B\u044C\u043D\u0430\u044F \u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0446\u0438\u044F: \u043D\u0430\u043A\u043B\u043E\u043D, \u043E\u0431\u0440\u0435\u0437\u0430\u043D\u043D\u044B\u0439 \u043A\u0440\u0430\u0439, \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0439 \u0440\u0430\u043A\u0443\u0440\u0441;",
    "- \u0436\u0438\u0432\u043E\u0439 \u043C\u043E\u043C\u0435\u043D\u0442: \u0440\u0443\u043A\u0430, \u0442\u0435\u043B\u0435\u0444\u043E\u043D, \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0432 \u043A\u0430\u0434\u0440\u0435, \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435, \u0442\u0435\u043D\u044C \u043E\u0442 \u0441\u043D\u0438\u043C\u0430\u044E\u0449\u0435\u0433\u043E;",
    "- \u043C\u0435\u0441\u0442\u043E, \u0433\u0434\u0435 \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0440\u0435\u0430\u043B\u044C\u043D\u043E \u043C\u043E\u0433 \u0431\u044B\u0442\u044C: \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0430, \u0434\u0432\u043E\u0440, \u043A\u0430\u0444\u0435, \u0443\u043B\u0438\u0446\u0430.",
    "",
    "\u041F\u0420\u0418\u0417\u041D\u0410\u041A\u0418 \u041A\u0410\u0420\u0422\u0418\u041D\u041A\u0418 \u0418\u0417 \u0418\u041D\u0422\u0415\u0420\u041D\u0415\u0422\u0410:",
    "- \u0432\u043E\u0434\u044F\u043D\u043E\u0439 \u0437\u043D\u0430\u043A, \u043B\u043E\u0433\u043E\u0442\u0438\u043F \u0441\u0430\u0439\u0442\u0430, \u043F\u043E\u0434\u043F\u0438\u0441\u044C \u0430\u0432\u0442\u043E\u0440\u0430, \u0440\u0430\u043C\u043A\u0430 \u0438 \u043F\u043E\u043B\u044F \u043A\u0430\u043A \u0443 \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0438 \u0438\u0437 \u043F\u043E\u0434\u0431\u043E\u0440\u043A\u0438;",
    "- \u043A\u0430\u0442\u0430\u043B\u043E\u0436\u043D\u0430\u044F \u0438\u043B\u0438 \u0440\u0435\u043A\u043B\u0430\u043C\u043D\u0430\u044F \u0441\u044A\u0451\u043C\u043A\u0430: \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439 \u0440\u043E\u0432\u043D\u044B\u0439 \u0441\u0432\u0435\u0442, \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u0430\u044F \u0443\u0431\u043E\u0440\u043A\u0430, \u0441\u0438\u043C\u043C\u0435\u0442\u0440\u0438\u044F, \u0432\u0438\u0442\u0440\u0438\u043D\u043D\u044B\u0439 \u0444\u043E\u043D;",
    "- \u043F\u0440\u0435\u0434\u043C\u0435\u0442, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0432 \u043E\u0431\u044B\u0447\u043D\u043E\u043C \u0434\u043E\u043C\u0435: \u0448\u043E\u0443\u0440\u0443\u043C, \u043E\u0433\u0440\u043E\u043C\u043D\u0430\u044F \u043C\u0435\u0431\u0435\u043B\u044C \u043F\u043E\u0434 \u0437\u0430\u043A\u0430\u0437, \u0432\u0438\u0442\u0440\u0438\u043D\u0430, \u0434\u0435\u043A\u043E\u0440\u0430\u0446\u0438\u044F, \u0441\u0435\u0440\u0432\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u0441\u0442\u043E\u043B \u0440\u0435\u0441\u0442\u043E\u0440\u0430\u043D\u0430;",
    "- \u0441\u0442\u043E\u043A\u043E\u0432\u0430\u044F \u043F\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430: \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u0439 \u0440\u0435\u043A\u0432\u0438\u0437\u0438\u0442, \u043C\u043E\u0434\u0435\u043B\u044C \u0432 \u043F\u043E\u0437\u0435, \u043D\u0438 \u043E\u0434\u043D\u043E\u0439 \u043B\u0438\u0447\u043D\u043E\u0439 \u0434\u0435\u0442\u0430\u043B\u0438;",
    "- \u0442\u0435\u043A\u0441\u0442 \u043F\u043E\u0432\u0435\u0440\u0445 \u043A\u0430\u0434\u0440\u0430, \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u044F, \u0433\u0430\u043B\u0435\u0440\u0435\u0438 \u0438\u043B\u0438 \u0441\u043E\u0446\u0441\u0435\u0442\u0438, \u043A\u043E\u043B\u043B\u0430\u0436 \u0438\u0437 \u0440\u0430\u0437\u043D\u044B\u0445 \u0441\u043D\u0438\u043C\u043A\u043E\u0432.",
    "",
    "\u041A\u0410\u041A \u0420\u0415\u0428\u0410\u0422\u042C:",
    "1. \xABown\xBB \u2014 \u043A\u0430\u0434\u0440 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043A\u0430\u043A \u043B\u0438\u0447\u043D\u044B\u0439 \u0441\u043D\u0438\u043C\u043E\u043A \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043F\u0443\u0441\u0442\u044C \u0438 \u043D\u0435\u0438\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u0439. \u042D\u0442\u043E \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u043F\u043E \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E, \u043D\u043E \u043D\u0435 \u043E\u0442\u0433\u043E\u0432\u043E\u0440\u043A\u0430. \u0410\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u0430\u044F \u043A\u043E\u043C\u043D\u0430\u0442\u0430, \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0441\u0432\u0435\u0442 \u0438\u043B\u0438 \u043A\u0440\u0430\u0441\u0438\u0432\u0430\u044F \u043F\u043E\u0441\u0443\u0434\u0430 \u0441\u0430\u043C\u0438 \u043F\u043E \u0441\u0435\u0431\u0435 \u043D\u0435 \u043F\u0440\u0438\u0437\u043D\u0430\u043A \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442\u0430: \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u043D\u0438\u0435 \u0432\u044B\u0437\u044B\u0432\u0430\u0435\u0442 \u044F\u0432\u043D\u0430\u044F \u043A\u0430\u0442\u0430\u043B\u043E\u0436\u043D\u0430\u044F, \u0441\u0442\u0443\u0434\u0438\u0439\u043D\u0430\u044F \u0438\u043B\u0438 \u0440\u0435\u043A\u043B\u0430\u043C\u043D\u0430\u044F \u043F\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u043B\u0438\u0431\u043E \u043F\u0440\u0435\u0434\u043C\u0435\u0442, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043D\u0435 \u0431\u044B\u0432\u0430\u0435\u0442 \u0432 \u0436\u0438\u043B\u043E\u043C \u0434\u043E\u043C\u0435.",
    "2. \xABsuspicious\xBB \u2014 \u0435\u0441\u0442\u044C \u0445\u043E\u0442\u044F \u0431\u044B \u043E\u0434\u0438\u043D \u043F\u0440\u0438\u0437\u043D\u0430\u043A \u043A\u0430\u0442\u0430\u043B\u043E\u0436\u043D\u043E\u0439, \u0440\u0435\u043A\u043B\u0430\u043C\u043D\u043E\u0439 \u0438\u043B\u0438 \u0441\u0442\u043E\u043A\u043E\u0432\u043E\u0439 \u0441\u044A\u0451\u043C\u043A\u0438, \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u043F\u0440\u044F\u043C\u044B\u0445 \u0443\u043B\u0438\u043A \u043D\u0435\u0442. \u041B\u0443\u0447\u0448\u0435 \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u0430\u0445\u043E\u0432\u0430\u0442\u044C\u0441\u044F, \u0447\u0435\u043C \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0441\u043A\u0430\u0447\u0430\u043D\u043D\u0443\u044E \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0443.",
    "3. \xABdownloaded\xBB \u2014 \u0435\u0441\u0442\u044C \u043F\u0440\u044F\u043C\u0430\u044F \u0443\u043B\u0438\u043A\u0430: \u0432\u043E\u0434\u044F\u043D\u043E\u0439 \u0437\u043D\u0430\u043A, \u043B\u043E\u0433\u043E\u0442\u0438\u043F \u0441\u0430\u0439\u0442\u0430, \u0440\u0430\u043C\u043A\u0430 \u043F\u043E\u0434\u0431\u043E\u0440\u043A\u0438, \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441, \u043E\u0442\u043A\u0440\u043E\u0432\u0435\u043D\u043D\u043E \u043A\u0430\u0442\u0430\u043B\u043E\u0436\u043D\u044B\u0439 \u0442\u043E\u0432\u0430\u0440\u043D\u044B\u0439 \u043A\u0430\u0434\u0440. \u041D\u0430\u0437\u043E\u0432\u0438 \u0443\u043B\u0438\u043A\u0443 \u0432 note.",
    "4. \u041E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043C\u0435\u0442\u0430\u0434\u0430\u043D\u043D\u044B\u0445 \u043A\u0430\u043C\u0435\u0440\u044B \u0441\u0430\u043C\u043E \u043F\u043E \u0441\u0435\u0431\u0435 \u043D\u0435 \u0434\u0435\u043B\u0430\u0435\u0442 \u043A\u0430\u0434\u0440 \u0441\u043A\u0430\u0447\u0430\u043D\u043D\u044B\u043C: \u0444\u0430\u0439\u043B \u043C\u043E\u0433 \u043F\u0440\u043E\u0439\u0442\u0438 \u0447\u0435\u0440\u0435\u0437 \u043C\u0435\u0441\u0441\u0435\u043D\u0434\u0436\u0435\u0440. \u042D\u0442\u043E \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430, \u0430 \u043D\u0435 \u043F\u0440\u0438\u0433\u043E\u0432\u043E\u0440.",
    "5. \u041D\u0435 \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0439, \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043E \u043B\u0438 \u0437\u0430\u0434\u0430\u043D\u0438\u0435, \u0438 \u043D\u0435 \u043F\u0435\u0440\u0435\u0447\u0438\u0441\u043B\u044F\u0439 \u0435\u0433\u043E \u043F\u0443\u043D\u043A\u0442\u044B: \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435 \u043A\u0430\u0434\u0440\u0430.",
    "",
    "note \u2014 \u0434\u043E 12 \u0441\u043B\u043E\u0432 \u043F\u043E-\u0440\u0443\u0441\u0441\u043A\u0438 \u0438 \u043F\u043E \u0434\u0435\u043B\u0443: \xAB\u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439 \u0441\u0432\u0435\u0442 \u0438 \u0432\u0438\u0442\u0440\u0438\u043D\u043D\u044B\u0439 \u0444\u043E\u043D\xBB, \xAB\u043B\u043E\u0433\u043E\u0442\u0438\u043F \u0441\u0430\u0439\u0442\u0430 \u0432 \u0443\u0433\u043B\u0443\xBB, \xAB\u043B\u0438\u0447\u043D\u044B\u0439 \u0441\u043D\u0438\u043C\u043E\u043A \u0432 \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0435\xBB.",
    "",
    "\u0424\u041E\u0420\u041C\u0410\u0422 \u041E\u0422\u0412\u0415\u0422\u0410 \u2014 \u0441\u0442\u0440\u043E\u0433\u043E JSON:",
    '{"origin": "own" | "suspicious" | "downloaded", "confidence": <0..1>, "note": "<\u0434\u043E 12 \u0441\u043B\u043E\u0432 \u043F\u043E-\u0440\u0443\u0441\u0441\u043A\u0438>"}'
  ].join("\n");
}
__name(buildOriginPrompt, "buildOriginPrompt");

// api/_ai.ts
var PASS_SCORE = 70;
var INVALID_SCORE = 0;
var FALLBACK_MISS_PERCENT = 35;
var SOURCE_PENALTY = 20;
var SOURCE_DOWNLOADED_REASON = "\u041A\u0430\u0434\u0440 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043A\u0430\u043A \u0441\u043A\u0430\u0447\u0430\u043D\u043D\u044B\u0439 \u0438\u0437 \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442\u0430 \u2014 \u0434\u043B\u044F \u043A\u0432\u0435\u0441\u0442\u0430 \u043D\u0443\u0436\u0435\u043D \u0441\u0432\u043E\u0439 \u0441\u043D\u0438\u043C\u043E\u043A \u0441 \u043C\u0435\u0441\u0442\u0430.";
function extractText(result) {
  if (typeof result === "string") return result;
  const value = result;
  if (typeof value.response === "string") return value.response;
  if (typeof value.result?.response === "string") return value.result.response;
  const content = value.choices?.[0]?.message?.content;
  if (typeof content === "string") return content;
  if (Array.isArray(content)) {
    return content.map((part) => typeof part === "string" ? part : part?.text ?? "").join("");
  }
  return "";
}
__name(extractText, "extractText");
function normalize(value) {
  return value.toLowerCase().replace(/ё/g, "\u0435").replace(/[^a-zа-я0-9]+/gi, " ").trim();
}
__name(normalize, "normalize");
function parseRawDeductions(raw) {
  if (!Array.isArray(raw)) return [];
  const items = [];
  for (const entry of raw) {
    if (!entry || typeof entry !== "object") continue;
