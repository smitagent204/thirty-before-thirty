  {
    id: "l4-4",
    level: 4,
    order: 3,
    points: 7,
    emoji: "\u{1F942}",
    title: "\u041F\u0430\u0440\u0430\u0434\u043D\u044B\u0439 \u0441\u0435\u043C\u0435\u0439\u043D\u044B\u0439 \u043E\u0431\u0435\u0434 \u0441 \u0432\u0438\u0434\u043E\u043C \u043D\u0430 \u0441\u043E\u0431\u043E\u0440",
    description: "\u0412 \u043F\u043E\u043B\u0434\u0435\u043D\u044C \u0432\u044B\u0445\u043E\u0434\u043D\u043E\u0433\u043E \u0443\u0441\u0442\u0440\u043E\u0439\u0442\u0435 \u0441\u0435\u043C\u0435\u0439\u043D\u044B\u0439 \u043E\u0431\u0435\u0434 \u0432 \u0440\u0435\u0441\u0442\u043E\u0440\u0430\u043D\u0435 \u0441 \u0432\u0438\u0434\u043E\u043C \u043D\u0430 \u0418\u0441\u0430\u0430\u043A\u0438\u0435\u0432\u0441\u043A\u0438\u0439 \u0438\u043B\u0438 \u041A\u0430\u0437\u0430\u043D\u0441\u043A\u0438\u0439 \u0441\u043E\u0431\u043E\u0440 \u2014 \u0432\u0441\u0435 \u0432\u0442\u0440\u043E\u0451\u043C. \u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0432\u0440\u0435\u043C\u044F \u0441\u0440\u0430\u0437\u0443 \u043F\u043E\u0441\u043B\u0435 \u0434\u043D\u0435\u0432\u043D\u043E\u0433\u043E \u0441\u043D\u0430 \u043C\u0430\u043B\u044B\u0448\u0430 \u0438 \u043C\u0435\u0441\u0442\u043E, \u0433\u0434\u0435 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u0441 \u0440\u0435\u0431\u0451\u043D\u043A\u043E\u043C: \u0441\u0442\u043E\u043B\u0438\u043A \u0443 \u043E\u043A\u043D\u0430, \u0434\u0435\u0442\u0441\u043A\u043E\u0435 \u043C\u0435\u043D\u044E, \u043F\u0440\u043E\u0441\u0442\u043E\u0440\u043D\u044B\u0439 \u0437\u0430\u043B. \u041F\u0440\u0430\u0437\u0434\u043D\u0438\u043A \u0431\u0435\u0437 \u0434\u043E\u043B\u0433\u0438\u0445 \u0441\u0431\u043E\u0440\u043E\u0432 \u0438 \u0432\u0435\u0447\u0435\u0440\u043D\u0438\u0445 \u0443\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u043D\u0438\u0439.",
    photoHint: "\u0421\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u0439\u0442\u0435 \u0441\u0442\u043E\u043B\u0438\u043A \u0441 \u0432\u0438\u0434\u043E\u043C \u043D\u0430 \u0441\u043E\u0431\u043E\u0440: \u0432\u044B \u0432\u0442\u0440\u043E\u0451\u043C, \u0431\u043B\u044E\u0434\u0430 \u0438 \u0434\u0435\u0442\u0441\u043A\u0438\u0439 \u0441\u0442\u0443\u043B \u0438\u043B\u0438 \u043C\u0430\u043B\u044B\u0448 \u0437\u0430 \u0441\u0442\u043E\u043B\u043E\u043C.",
    rubric: {
      required: [
        {
          id: "cathedral",
          label: "\u0432\u0438\u0434 \u043D\u0430 \u0418\u0441\u0430\u0430\u043A\u0438\u0435\u0432\u0441\u043A\u0438\u0439 \u0438\u043B\u0438 \u041A\u0430\u0437\u0430\u043D\u0441\u043A\u0438\u0439 \u0441\u043E\u0431\u043E\u0440",
          miss: "\u043D\u0435\u0442 \u0441\u043E\u0431\u043E\u0440\u0430 \u0432 \u043A\u0430\u0434\u0440\u0435",
          weight: 35
        },
        {
