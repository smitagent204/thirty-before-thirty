    photoHint: "\u0421\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u0439 \u0430\u043B\u044C\u043F\u0430\u043A\u0443 \u043D\u0430 \u0444\u043E\u043D\u0435 \u0437\u0438\u043C\u043D\u0435\u0433\u043E \u0445\u0432\u043E\u0439\u043D\u043E\u0433\u043E \u043B\u0435\u0441\u0430 \u0438\u043B\u0438 \u0438\u043B\u043B\u044E\u043C\u0438\u043D\u0430\u0446\u0438\u0438. \u0425\u043E\u0440\u043E\u0448\u043E, \u0435\u0441\u043B\u0438 \u0432 \u043A\u0430\u0434\u0440 \u043F\u043E\u043F\u0430\u0434\u0451\u0442 \u043A\u0442\u043E-\u0442\u043E \u0438\u0437 \u0432\u0430\u0441 \u2014 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u0432 \u043C\u043E\u043C\u0435\u043D\u0442 \u043A\u043E\u0440\u043C\u043B\u0435\u043D\u0438\u044F.",
