    photoHint: "\u0417\u0430\u0433\u0440\u0443\u0437\u0438 \u0441\u043A\u0440\u0438\u043D\u0448\u043E\u0442 \u043C\u043E\u043D\u0442\u0430\u0436\u043D\u043E\u0433\u043E \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u0441 \u0442\u0430\u0439\u043C\u043B\u0430\u0439\u043D\u043E\u043C \u0438\u043B\u0438 \u043A\u0430\u0434\u0440 \u0433\u043E\u0442\u043E\u0432\u043E\u0433\u043E \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u043A\u043B\u0438\u043F\u0430. \u0421\u043A\u0440\u0438\u043D\u0448\u043E\u0442 \u0437\u0434\u0435\u0441\u044C \u2014 \u0447\u0430\u0441\u0442\u044C \u0437\u0430\u0434\u0430\u043D\u0438\u044F.",
