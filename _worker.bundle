          label: "\u0440\u0435\u0441\u0442\u043E\u0440\u0430\u043D\u043D\u044B\u0439 \u0441\u0442\u043E\u043B\u0438\u043A \u0438\u043B\u0438 \u0431\u043B\u044E\u0434\u0430",
          miss: "\u043D\u0435\u0442 \u0441\u0442\u043E\u043B\u0438\u043A\u0430 \u0438\u043B\u0438 \u0431\u043B\u044E\u0434",
          weight: 25
        },
        {
