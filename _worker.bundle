      ],
      optional: [
        "\u0432\u0441\u044F \u0441\u0435\u043C\u044C\u044F \u0437\u0430 \u0441\u0442\u043E\u043B\u043E\u043C",
        "\u0441\u043E\u0431\u043E\u0440 \u0443\u0437\u043D\u0430\u0432\u0430\u0435\u043C",
        "\u0432\u0438\u0434\u043D\u0430 \u0441\u0435\u0440\u0432\u0438\u0440\u043E\u0432\u043A\u0430 \u043E\u0431\u0435\u0434\u0430: \u043F\u0440\u0438\u0431\u043E\u0440\u044B, \u0431\u043B\u044E\u0434\u0430, \u043D\u0430\u043F\u0438\u0442\u043A\u0438",
        "\u0434\u0435\u0441\u0435\u0440\u0442 \u0438\u043B\u0438 \u043A\u0440\u0430\u0441\u0438\u0432\u0430\u044F \u043F\u043E\u0434\u0430\u0447\u0430",
        "\u0432\u0438\u0434 \u0438\u0437 \u043E\u043A\u043D\u0430 \u0438\u043B\u0438 \u0441 \u0442\u0435\u0440\u0440\u0430\u0441\u044B \u0446\u0435\u043B\u0438\u043A\u043E\u043C",
        "\u043C\u0430\u043B\u044B\u0448 \u0435\u0441\u0442 \u0438\u043B\u0438 \u0438\u0433\u0440\u0430\u0435\u0442 \u0437\u0430 \u0441\u0442\u043E\u043B\u043E\u043C"
      ]
    }
  }
];

