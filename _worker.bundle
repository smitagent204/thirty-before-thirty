        "\u0432 \u043A\u0430\u0434\u0440\u0435 \u0434\u0432\u0435 \u043A\u0440\u0443\u0436\u043A\u0438 \u0438\u043B\u0438 \u0434\u0432\u0430 \u0441\u0442\u0443\u043B\u0430",
        "\u0442\u0451\u043F\u043B\u044B\u0439 \u0434\u043E\u043C\u0430\u0448\u043D\u0438\u0439 \u0441\u0432\u0435\u0442",
        "\u0432\u0438\u0434\u0435\u043D \u0434\u0435\u0442\u0441\u043A\u0438\u0439 \u043C\u043E\u043D\u0438\u0442\u043E\u0440 \u0438\u043B\u0438 \u0441\u043F\u044F\u0449\u0438\u0439 \u043C\u0430\u043B\u044B\u0448 \u0440\u044F\u0434\u043E\u043C",
        "\u043D\u0430 \u0441\u0442\u043E\u043B\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0438\u0433\u0440 \u043D\u0430 \u0432\u044B\u0431\u043E\u0440",
        "\u0441\u0432\u0435\u0447\u0430, \u0433\u0438\u0440\u043B\u044F\u043D\u0434\u0430 \u0438\u043B\u0438 \u0434\u0440\u0443\u0433\u043E\u0439 \u0443\u044E\u0442\u043D\u044B\u0439 \u0441\u0432\u0435\u0442"
      ]
    }
  },
  {
