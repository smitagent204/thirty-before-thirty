          label: "\u043D\u0430\u043A\u0440\u044B\u0442\u044B\u0439 \u0441\u0442\u043E\u043B \u0441 \u0435\u0434\u043E\u0439",
          miss: "\u043D\u0435\u0442 \u043D\u0430\u043A\u0440\u044B\u0442\u043E\u0433\u043E \u0441\u0442\u043E\u043B\u0430 \u0441 \u0435\u0434\u043E\u0439",
          weight: 35
