          label: "\u0440\u044F\u0434\u043E\u043C \u0432\u0438\u0434\u043D\u0430 \u043E\u0431\u043B\u043E\u0436\u043A\u0430",
          miss: "\u043E\u0431\u043B\u043E\u0436\u043A\u0438 \u043D\u0435 \u0432\u0438\u0434\u043D\u043E",
