    description: "\u0412\u044B\u0431\u0435\u0440\u0438 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E\u0435 \u043E\u043A\u043D\u043E, \u043A\u043E\u0433\u0434\u0430 \u043C\u0430\u043B\u044B\u0448 \u0437\u0430\u043D\u044F\u0442 \u0438\u043B\u0438 \u0443\u0436\u0435 \u0441\u043F\u0438\u0442: \u0434\u043E\u0441\u0442\u0430\u043D\u044C \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043D\u0443\u044E \u0438\u0433\u0440\u0443 \u0438 \u0443\u0431\u0435\u0440\u0438 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u044B \u0432 \u0434\u0440\u0443\u0433\u0443\u044E \u043A\u043E\u043C\u043D\u0430\u0442\u0443. \u041F\u0443\u0441\u0442\u044C \u044D\u0442\u043E \u0431\u0443\u0434\u0435\u0442 \u043E\u0434\u0438\u043D \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0439 \u0440\u0430\u0443\u043D\u0434 \u0431\u0435\u0437 \u0441\u043F\u0435\u0448\u043A\u0438: \u0447\u0430\u0439, \u043F\u043B\u0435\u0434 \u0438 \u043B\u044E\u0431\u0438\u043C\u0430\u044F \u0438\u0433\u0440\u0430. \u0421\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u0439 \u0441\u0442\u043E\u043B \u0434\u043E \u0438\u043B\u0438 \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u043F\u0430\u0440\u0442\u0438\u0438 \u2014 \u0433\u043B\u0430\u0432\u043D\u043E\u0435, \u0447\u0442\u043E\u0431\u044B \u0431\u044B\u043B\u043E \u0432\u0438\u0434\u043D\u043E, \u0447\u0442\u043E \u0432\u0440\u0435\u043C\u044F \u0432\u0430\u0448\u0435, \u0430 \u043D\u0435 \u044D\u043A\u0440\u0430\u043D\u043D\u043E\u0435.",
    photoHint: "\u0421\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u0439 \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043D\u0443\u044E \u0438\u0433\u0440\u0443 \u043D\u0430 \u0441\u0442\u043E\u043B\u0435: \u0432\u0438\u0434\u043D\u044B \u0444\u0438\u0448\u043A\u0438, \u043A\u0430\u0440\u0442\u044B \u0438\u043B\u0438 \u043F\u043E\u043B\u0435, \u0440\u044F\u0434\u043E\u043C \u2014 \u0447\u0430\u0439 \u0438\u043B\u0438 \u043F\u043B\u0435\u0434. \u0422\u0435\u043B\u0435\u0444\u043E\u043D\u044B \u0432 \u043A\u0430\u0434\u0440 \u043D\u0435 \u043D\u0443\u0436\u043D\u044B.",
    rubric: {
