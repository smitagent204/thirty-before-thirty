    description: "\u041F\u0440\u0438\u0433\u043B\u0430\u0441\u0438 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0430 \u0434\u043E\u043C\u043E\u0439 \u043D\u0430 \u0447\u0430\u0441 \u0443\u0442\u0440\u043E\u043C, \u043A\u043E\u0433\u0434\u0430 \u043C\u0430\u043B\u044B\u0448 \u0431\u043E\u0434\u0440 \u0438 \u0432\u0435\u0441\u0435\u043B. \u0421\u043D\u0438\u043C\u0438\u0442\u0435 \u0436\u0438\u0432\u044B\u0435 \u043E\u0431\u044A\u044F\u0442\u0438\u044F \u0432 \u043A\u0440\u043E\u0432\u0430\u0442\u0438, \u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439 \u043A\u043E\u0444\u0435, \u0441\u043C\u0435\u0445 \u043D\u0430 \u0440\u0443\u043A\u0430\u0445 \u0443 \u043F\u0430\u043F\u044B \u0438 \u0442\u0432\u043E\u0438 \u043F\u043E\u0440\u0442\u0440\u0435\u0442\u044B \u0443 \u043E\u043A\u043D\u0430. \u0411\u0435\u0437 \u0441\u0431\u043E\u0440\u043E\u0432 \u0432 \u0441\u0442\u0443\u0434\u0438\u044E \u0438 \u0431\u0435\u0437 \u043A\u0430\u043F\u0440\u0438\u0437\u043E\u0432 \u0438\u0437-\u0437\u0430 \u0441\u043D\u0430.",
    photoHint: "\u0417\u0430\u0433\u0440\u0443\u0437\u0438 2\u20133 \u043A\u0430\u0434\u0440\u0430 \u0441 \u0434\u043E\u043C\u0430\u0448\u043D\u0435\u0439 \u0441\u044A\u0451\u043C\u043A\u0438: \u043E\u0431\u044A\u044F\u0442\u0438\u044F \u0432 \u043A\u0440\u043E\u0432\u0430\u0442\u0438, \u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439 \u043A\u043E\u0444\u0435, \u043F\u043E\u0440\u0442\u0440\u0435\u0442 \u0443 \u043E\u043A\u043D\u0430.",
