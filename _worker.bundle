        "\u0432\u0438\u0434\u0435\u043D \u043F\u0440\u043E\u0446\u0435\u0441\u0441: \u0440\u0430\u0441\u0442\u043E\u043F\u043B\u0435\u043D\u043D\u044B\u0439 \u0432\u043E\u0441\u043A, \u0437\u0430\u043B\u0438\u0432\u043A\u0430, \u0444\u0438\u043A\u0441\u0430\u0446\u0438\u044F \u0444\u0438\u0442\u0438\u043B\u044F",
        "\u0441\u0430\u043C\u043E\u0434\u0435\u043B\u044C\u043D\u0430\u044F \u044D\u0442\u0438\u043A\u0435\u0442\u043A\u0430 \u0441 \u0430\u0440\u043E\u043C\u0430\u0442\u043E\u043C \u0438\u043B\u0438 \u0434\u0430\u0442\u043E\u0439",
        "\u0432\u0438\u0434\u043D\u043E \u043C\u0435\u0441\u0442\u043E, \u0433\u0434\u0435 \u0441\u0442\u043E\u0438\u0442 \u0441\u0432\u0435\u0447\u0430: \u0441\u0442\u043E\u043B, \u043F\u043E\u043B\u043A\u0430 \u0438\u043B\u0438 \u043F\u043E\u0434\u043E\u043A\u043E\u043D\u043D\u0438\u043A"
