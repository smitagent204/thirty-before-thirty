  {
    id: "l2-1",
    level: 2,
    order: 1,
    points: 2,
    allowCollage: true,
    emoji: "\u{1F9CB}",
    title: "\xAB\u041A\u043E\u0444\u0435\u0439\u043D\u043E\u0435 \u0431\u0438\u043D\u0433\u043E\xBB \u0440\u0430\u0439\u043E\u043D\u0430 \u0414\u044B\u0431\u0435\u043D\u043A\u043E \u2014 \u041A\u0443\u0434\u0440\u043E\u0432\u043E",
    description: "\u0412\u044B\u0431\u0435\u0440\u0438 \u0442\u0440\u0438 \u043A\u043E\u0444\u0435\u0439\u043D\u0438 \u0443 \u0434\u043E\u043C\u0430 \u0438 \u0432 \u043A\u0430\u0436\u0434\u043E\u0439 \u0432\u043E\u0437\u044C\u043C\u0438 \u0441\u0430\u043C\u0443\u044E \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u0443\u044E \u043F\u043E\u0437\u0438\u0446\u0438\u044E: \u0441\u044B\u0440\u043D\u044B\u0439 \u0438\u043B\u0438 \u043B\u0430\u0432\u0430\u043D\u0434\u043E\u0432\u044B\u0439 \u0440\u0430\u0444, \u0444\u0438\u043B\u044C\u0442\u0440 \u043D\u0430 \u0440\u0435\u0434\u043A\u043E\u043C \u0437\u0435\u0440\u043D\u0435, \u043C\u0430\u0442\u0442\u044F-\u0442\u043E\u043D\u0438\u043A, \u043A\u0430\u043A\u0430\u043E \u0441\u043E \u0441\u043F\u0435\u0446\u0438\u044F\u043C\u0438. \u0421\u043E\u0445\u0440\u0430\u043D\u0438 \u0447\u0435\u043A\u0438 \u0438\u043B\u0438 \u0437\u0430\u043F\u043E\u043C\u043D\u0438 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F \u2014 \u043F\u043E\u0442\u043E\u043C \u0441\u0440\u0430\u0432\u043D\u0438\u0448\u044C, \u0433\u0434\u0435 \u0432\u043A\u0443\u0441\u043D\u0435\u0435. \u041F\u043E\u0440\u0446\u0438\u0438 \u043C\u043E\u0436\u043D\u043E \u0431\u0440\u0430\u0442\u044C \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435 \u0438\u043B\u0438 \u0434\u0435\u043B\u0438\u0442\u044C \u0441 \u043C\u0443\u0436\u0435\u043C: \u0437\u0434\u0435\u0441\u044C \u0432\u0430\u0436\u0435\u043D \u0432\u043A\u0443\u0441, \u0430 \u043D\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E.",
    photoHint: "\u041A\u043E\u043B\u043B\u0430\u0436 \u0438\u0437 \u0442\u0440\u0451\u0445 \u043A\u0430\u0434\u0440\u043E\u0432: \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443 \u043D\u0430\u043F\u0438\u0442\u043A\u0443 \u0438\u0437 \u043A\u0430\u0436\u0434\u043E\u0439 \u043A\u043E\u0444\u0435\u0439\u043D\u0438. \u0414\u043B\u044F \u0437\u0430\u0447\u0451\u0442\u0430 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0434\u0432\u0443\u0445 \u0440\u0430\u0437\u043D\u044B\u0445 \u043C\u0435\u0441\u0442 \u2014 \u0442\u0440\u0435\u0442\u0438\u0439 \u043A\u0430\u0434\u0440 \u0438 \u0447\u0435\u043A\u0438 \u043F\u0440\u0438\u044F\u0442\u043D\u044B\u0439 \u0431\u043E\u043D\u0443\u0441.",
    rubric: {
      required: [
        {
