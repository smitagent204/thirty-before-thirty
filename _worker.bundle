          miss: "\u043D\u0435\u0442 \u0432\u0435\u0447\u0435\u0440\u043D\u0435\u0439 \u043E\u0431\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438",
          weight: 20
        },
        {
