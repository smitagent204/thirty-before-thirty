    points: 2,
    emoji: "\u{1F370}",
    title: "\u0424\u0438\u0440\u043C\u0435\u043D\u043D\u044B\u0439 \u0434\u0435\u0441\u0435\u0440\u0442 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u0438\u043B\u0435\u0442\u0438\u044F",
    description: "\u041F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u044C \u043E\u0434\u0438\u043D \u044D\u0444\u0444\u0435\u043A\u0442\u043D\u044B\u0439 \u0434\u0435\u0441\u0435\u0440\u0442 \u043F\u043E \u043F\u0440\u043E\u0441\u0442\u043E\u043C\u0443 \u0440\u0435\u0446\u0435\u043F\u0442\u0443: \u043E\u0431\u043E\u0436\u0436\u0451\u043D\u043D\u044B\u0439 \u0431\u0430\u0441\u043A\u0441\u043A\u0438\u0439 \u0447\u0438\u0437\u043A\u0435\u0439\u043A \u0438\u043B\u0438 \u0442\u0438\u0440\u0430\u043C\u0438\u0441\u0443 \u0432 \u0431\u043E\u043A\u0430\u043B\u0430\u0445. \u0414\u0430\u0439 \u043E\u0441\u0442\u044B\u0442\u044C, \u0443\u043A\u0440\u0430\u0441\u044C \u0438 \u043F\u043E\u0434\u0430\u0439 \u043A\u0430\u043A \u0432 \u0440\u0435\u0441\u0442\u043E\u0440\u0430\u043D\u0435. \u0420\u0435\u0446\u0435\u043F\u0442 \u043D\u0435 \u0434\u043E\u043B\u0436\u0435\u043D \u0437\u0430\u043D\u0438\u043C\u0430\u0442\u044C \u0432\u0435\u0441\u044C \u0432\u0435\u0447\u0435\u0440 \u2014 \u0432\u0430\u0436\u0435\u043D \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u0438 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435.",
    photoHint: "\u0421\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u0439 \u0433\u043E\u0442\u043E\u0432\u044B\u0439 \u0434\u0435\u0441\u0435\u0440\u0442 \u043A\u0440\u0443\u043F\u043D\u044B\u043C \u043F\u043B\u0430\u043D\u043E\u043C: \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u0438\u0435, \u043A\u0440\u0430\u0441\u0438\u0432\u0430\u044F \u0442\u0430\u0440\u0435\u043B\u043A\u0430 \u0438\u043B\u0438 \u0431\u043E\u043A\u0430\u043B.",
