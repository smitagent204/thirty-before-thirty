          label: "\u0442\u0435\u043B\u0435\u0444\u043E\u043D \u0438\u043B\u0438 \u044D\u043A\u0440\u0430\u043D \u043D\u0435 \u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u043E\u0431\u044A\u0435\u043A\u0442 \u043A\u0430\u0434\u0440\u0430",
          miss: "\u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u043E\u0431\u044A\u0435\u043A\u0442 \u043A\u0430\u0434\u0440\u0430 \u2014 \u0442\u0435\u043B\u0435\u0444\u043E\u043D \u0438\u043B\u0438 \u044D\u043A\u0440\u0430\u043D",
