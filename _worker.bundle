  {
    id: "l4-1",
    level: 4,
    order: 4,
    points: 7,
    emoji: "\u{1F3E8}",
    title: "\u0417\u0430\u0433\u043E\u0440\u043E\u0434\u043D\u044B\u0439 \u043E\u0442\u0435\u043B\u044C \u043D\u0430 \u043E\u0434\u043D\u0443 \u043D\u043E\u0447\u044C",
    description: "\u0412\u044B\u0431\u0435\u0440\u0438 \u043E\u0434\u043D\u0443 \u043D\u043E\u0447\u044C \u0432 \u0437\u0430\u0433\u043E\u0440\u043E\u0434\u043D\u043E\u043C \u043E\u0442\u0435\u043B\u0435 \u0431\u0435\u0437 \u0441\u043F\u0430-\u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B \u0438 \u043F\u043B\u043E\u0442\u043D\u043E\u0433\u043E \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u044F: \u043B\u0435\u0441, \u0442\u0438\u0448\u0438\u043D\u0430, \u0437\u0430\u0432\u0442\u0440\u0430\u043A \u0443 \u043E\u043A\u043D\u0430 \u0438 \u043D\u0438\u043A\u0430\u043A\u043E\u0439 \u0441\u043F\u0435\u0448\u043A\u0438. \u041C\u0430\u043B\u044B\u0448 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u0441 \u0431\u0430\u0431\u0443\u0448\u043A\u043E\u0439 \u0438\u043B\u0438 \u0442\u0435\u043C, \u043A\u043E\u043C\u0443 \u0434\u043E\u0432\u0435\u0440\u044F\u0435\u0448\u044C, \u0430 \u0432\u044B \u0441 \u043C\u0443\u0436\u0435\u043C \u043F\u0440\u043E\u0441\u0442\u043E \u043C\u0435\u043D\u044F\u0435\u0442\u0435 \u043E\u0431\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443. \u042D\u0442\u043E \u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u0431\u0435\u0437 \u043F\u043E\u0434\u0432\u0438\u0433\u043E\u0432 \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u044B, \u0442\u0438\u0448\u0438\u043D\u0430 \u0438 \u0446\u0435\u043B\u0430\u044F \u043D\u043E\u0447\u044C.",
    photoHint: "\u0421\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u0439 \u043D\u043E\u043C\u0435\u0440 \u0438\u043B\u0438 \u0437\u0430\u0432\u0442\u0440\u0430\u043A \u0441 \u0432\u0438\u0434\u043E\u043C: \u043A\u0440\u043E\u0432\u0430\u0442\u044C \u043B\u0438\u0431\u043E \u0441\u0435\u0440\u0432\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u0441\u0442\u043E\u043B \u0438 \u043F\u0440\u0438\u043C\u0435\u0442\u044B \u043E\u0442\u0435\u043B\u044F \u0438\u043B\u0438 \u043F\u0440\u0438\u0440\u043E\u0434\u044B \u2014 \u043B\u0435\u0441 \u0437\u0430 \u043E\u043A\u043D\u043E\u043C, \u0442\u0435\u0440\u0440\u0430\u0441\u0430, \u0445\u0430\u043B\u0430\u0442\u044B \u0438\u043B\u0438 \u043A\u043B\u044E\u0447. \u0414\u0432\u0435 \u0447\u0430\u0448\u043A\u0438 \u0438\u043B\u0438 \u0434\u0432\u0430 \u0431\u043E\u043A\u0430\u043B\u0430 \u2014 \u043F\u0440\u0438\u044F\u0442\u043D\u044B\u0439 \u0431\u043E\u043D\u0443\u0441, \u043D\u043E \u043D\u0435 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u044B.",
    rubric: {
      required: [
        {
          id: "room",
          label: "\u043D\u043E\u043C\u0435\u0440 \u043E\u0442\u0435\u043B\u044F \u0438\u043B\u0438 \u0437\u0430\u0432\u0442\u0440\u0430\u043A",
          miss: "\u043D\u0435\u0442 \u043D\u043E\u043C\u0435\u0440\u0430 \u0438\u043B\u0438 \u0437\u0430\u0432\u0442\u0440\u0430\u043A\u0430",
          weight: 35
        },
        {
          id: "nature",
          label: "\u0437\u0430\u0433\u043E\u0440\u043E\u0434\u043D\u0430\u044F \u043E\u0431\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u0438\u043B\u0438 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u044F \u043E\u0442\u0435\u043B\u044F: \u043B\u0435\u0441, \u043F\u0440\u0438\u0440\u043E\u0434\u0430 \u0438\u043B\u0438 \u0432\u0438\u0434 \u0438\u0437 \u043E\u043A\u043D\u0430",
