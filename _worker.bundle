    points: 2,
    allowCollage: true,
    formatHint: "\u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0438 \u0432\u043D\u0443\u0442\u0440\u0438 \u043A\u0430\u0440\u0442\u044B \u0436\u0435\u043B\u0430\u043D\u0438\u0439 \u2014 \u0432\u044B\u0440\u0435\u0437\u043A\u0438 \u0438\u0437 \u0436\u0443\u0440\u043D\u0430\u043B\u043E\u0432 \u0438\u043B\u0438 \u0440\u0430\u0441\u043F\u0435\u0447\u0430\u0442\u043A\u0438 \u0438\u0437 \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442\u0430, \u0442\u0430\u043A \u0438 \u0437\u0430\u0434\u0443\u043C\u0430\u043D\u043E; \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0439, \u0447\u0442\u043E \u0441\u0430\u043C\u0443 \u043A\u0430\u0440\u0442\u0443 \u0441\u043D\u044F\u043B \u0447\u0435\u043B\u043E\u0432\u0435\u043A",
    emoji: "\u{1F320}",
    title: "\u041A\u0430\u0440\u0442\u0430 \u0436\u0435\u043B\u0430\u043D\u0438\u0439 \u043D\u0430 \u0433\u043E\u0434 \u0434\u043E 31",
    description: "\u0421\u043E\u0431\u0435\u0440\u0438 \u043A\u0430\u0440\u0442\u0443 \u0436\u0435\u043B\u0430\u043D\u0438\u0439 \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0433\u043E\u0434: \u0432\u044B\u0440\u0435\u0436\u0438 \u0438\u043B\u0438 \u0440\u0430\u0441\u043F\u0435\u0447\u0430\u0442\u0430\u0439 \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0438, \u043D\u0430\u043A\u043B\u0435\u0439 \u043D\u0430 \u043F\u043B\u043E\u0442\u043D\u044B\u0439 \u043B\u0438\u0441\u0442 \u0438 \u043F\u043E\u0434\u043F\u0438\u0448\u0438 10\u201315 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0445 \u0436\u0435\u043B\u0430\u043D\u0438\u0439. \u041F\u043E\u0432\u0435\u0441\u044C \u0442\u0443\u0434\u0430, \u0433\u0434\u0435 \u0431\u0443\u0434\u0435\u0448\u044C \u0432\u0438\u0434\u0435\u0442\u044C \u0435\u0451 \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C. \u0425\u0432\u0430\u0442\u0438\u0442 40\u201360 \u043C\u0438\u043D\u0443\u0442 \u0438 \u043E\u0434\u043D\u043E\u0433\u043E \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E\u0433\u043E \u0432\u0435\u0447\u0435\u0440\u0430 \u2014 \u0438\u043B\u0438 \u043B\u044E\u0431\u043E\u0433\u043E \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0433\u043E \u043E\u043A\u043D\u0430 \u0434\u043D\u0451\u043C.",
    photoHint: "\u0421\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u0439 \u0433\u043E\u0442\u043E\u0432\u0443\u044E \u043A\u0430\u0440\u0442\u0443 \u0446\u0435\u043B\u0438\u043A\u043E\u043C: \u0432\u0438\u0434\u0435\u043D \u043A\u043E\u043B\u043B\u0430\u0436 \u0438\u0437 \u043A\u0430\u0440\u0442\u0438\u043D\u043E\u043A, \u043F\u043E\u0434\u043F\u0438\u0441\u0438 \u0438 \u043C\u0435\u0441\u0442\u043E, \u0433\u0434\u0435 \u043E\u043D\u0430 \u0432\u0438\u0441\u0438\u0442. \u0414\u0435\u0441\u044F\u0442\u0438 \u0436\u0435\u043B\u0430\u043D\u0438\u0439 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E.",
    rubric: {
      required: [
        {
          id: "collage",
          label: "\u043B\u0438\u0441\u0442 \u0438\u043B\u0438 \u043F\u043B\u0430\u043A\u0430\u0442 \u0441 \u043A\u043E\u043B\u043B\u0430\u0436\u0435\u043C \u0438\u0437 \u043A\u0430\u0440\u0442\u0438\u043D\u043E\u043A",
          miss: "\u043D\u0435\u0442 \u043A\u043E\u043B\u043B\u0430\u0436\u0430 \u0438\u0437 \u043A\u0430\u0440\u0442\u0438\u043D\u043E\u043A",
          weight: 35
        },
        {
          id: "wishes",
          label: "\u043D\u0435 \u043C\u0435\u043D\u044C\u0448\u0435 \u0434\u0435\u0441\u044F\u0442\u0438 \u043A\u0430\u0440\u0442\u0438\u043D\u043E\u043A \u0438\u043B\u0438 \u0436\u0435\u043B\u0430\u043D\u0438\u0439",
          miss: "\u043C\u0435\u043D\u044C\u0448\u0435 \u0434\u0435\u0441\u044F\u0442\u0438 \u0436\u0435\u043B\u0430\u043D\u0438\u0439",
          weight: 25
        },
        {
          id: "notes",
          label: "\u0435\u0441\u0442\u044C \u043F\u043E\u0434\u043F\u0438\u0441\u0438 \u0438\u043B\u0438 \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u043D\u044B\u0439 \u0442\u0435\u043A\u0441\u0442",
          miss: "\u043D\u0435\u0442 \u043F\u043E\u0434\u043F\u0438\u0441\u0435\u0439",
          weight: 20
        },
        {
          id: "placement",
          label: "\u043A\u0430\u0440\u0442\u0430 \u0432\u0438\u0441\u0438\u0442 \u0438\u043B\u0438 \u0441\u0442\u043E\u0438\u0442 \u043D\u0430 \u0432\u0438\u0434\u043D\u043E\u043C \u043C\u0435\u0441\u0442\u0435",
          miss: "\u043A\u0430\u0440\u0442\u0430 \u043D\u0435 \u043D\u0430 \u0432\u0438\u0434\u043D\u043E\u043C \u043C\u0435\u0441\u0442\u0435",
          weight: 15
        }
      ],
      optional: [
        "\u0443\u043A\u0430\u0437\u0430\u043D \u0433\u043E\u0434 \u0438\u043B\u0438 \u0434\u0430\u0442\u0430 \xAB\u0434\u043E 31\xBB",
        "\u0432\u0438\u0434\u043D\u0430 \u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0446\u0438\u044F: \u0441\u0435\u043A\u0442\u043E\u0440\u044B, \u0433\u0440\u0443\u043F\u043F\u044B, \u0441\u0442\u0440\u0435\u043B\u043A\u0438",
        "\u0436\u0435\u043B\u0430\u043D\u0438\u044F \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0435 \u0438 \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043D\u044B \u043E\u0442 \u0440\u0443\u043A\u0438",
        "\u0435\u0441\u0442\u044C \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438 \u0438\u043B\u0438 \u0440\u0438\u0441\u0443\u043D\u043A\u0438, \u0430 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u044B\u0440\u0435\u0437\u043A\u0438"
      ]
    }
  },
  {
    id: "l2-7",
    level: 2,
    order: 7,
    points: 2,
    emoji: "\u{1F4D6}",
    title: "\u041A\u043D\u0438\u0436\u043D\u0430\u044F \u0440\u0443\u043B\u0435\u0442\u043A\u0430 \u0432\u0441\u043B\u0435\u043F\u0443\u044E",
    description: "\u0417\u0430\u0439\u0434\u0438 \u0432 \u043A\u043D\u0438\u0436\u043D\u044B\u0439 \u0432 \xAB\u041C\u0415\u0413\u0415 \u0414\u044B\u0431\u0435\u043D\u043A\u043E\xBB \u0438\u043B\u0438 \u043A\u043E\u0444\u0435\u0439\u043D\u044E \u0441 \u0431\u0443\u043A\u043A\u0440\u043E\u0441\u0441\u0438\u043D\u0433\u043E\u043C. \u0412\u044B\u0431\u0435\u0440\u0438 \u043A\u043D\u0438\u0433\u0443 \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E \u043F\u0435\u0440\u0432\u043E\u0439 \u0441\u0442\u0440\u043E\u0447\u043A\u0435 \u043D\u0430 30-\u0439 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0435, \u043D\u0435 \u0447\u0438\u0442\u0430\u044F \u0430\u043D\u043D\u043E\u0442\u0430\u0446\u0438\u044E \u0438 \u043E\u0442\u0437\u044B\u0432\u044B. \u0421\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u0439 \u0440\u0430\u0437\u0432\u043E\u0440\u043E\u0442 \u2014 \u043F\u043E\u0442\u043E\u043C \u0431\u0443\u0434\u0435\u0442 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E \u0441\u0440\u0430\u0432\u043D\u0438\u0442\u044C \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u0435 \u0441 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E.",
    photoHint: "\u0421\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u0439 \u043E\u0442\u043A\u0440\u044B\u0442\u0443\u044E \u043A\u043D\u0438\u0433\u0443 \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E \u043D\u0430 30-\u0439 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0435: \u0432\u0438\u0434\u043D\u0430 \u043F\u0435\u0440\u0432\u0430\u044F \u0441\u0442\u0440\u043E\u043A\u0430 \u0438 \u043E\u0431\u043B\u043E\u0436\u043A\u0430 \u0440\u044F\u0434\u043E\u043C. \u0422\u043E\u0447\u043D\u044B\u0439 \u043D\u043E\u043C\u0435\u0440 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u044B \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0442\u044C \u043D\u0435 \u043D\u0443\u0436\u043D\u043E.",
    rubric: {
