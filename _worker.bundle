    order: 3,
    points: 2,
    emoji: "\u{1FA99}",
    title: "\u041C\u043E\u043D\u0435\u0442\u043A\u0430 \u0441 \u043C\u043E\u0441\u0442\u0438\u043A\u0430 \u0447\u0435\u0440\u0435\u0437 \u041E\u043A\u043A\u0435\u0440\u0432\u0438\u043B\u044C",
    description: "\u041D\u0430\u0439\u0434\u0438 \u0441\u0432\u043E\u0439 \xAB\u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u044B\u0439 \u043C\u043E\u0441\u0442\u0438\u043A\xBB \u0432 \u043F\u0430\u0440\u043A\u0435 \u041E\u043A\u043A\u0435\u0440\u0432\u0438\u043B\u044C \u0438\u043B\u0438 \u043F\u0430\u0440\u043A\u0435 \u0415\u0441\u0435\u043D\u0438\u043D\u0430. \u041F\u043E\u043A\u043E\u0440\u043C\u0438 \u0443\u0442\u043E\u043A, \u0431\u0440\u043E\u0441\u044C \u043C\u043E\u043D\u0435\u0442\u043A\u0443 \u0447\u0435\u0440\u0435\u0437 \u043B\u0435\u0432\u043E\u0435 \u043F\u043B\u0435\u0447\u043E \u0438 \u0437\u0430\u0433\u0430\u0434\u0430\u0439 \u0436\u0435\u043B\u0430\u043D\u0438\u0435. \u042D\u0442\u043E \u0437\u0438\u043C\u043D\u044F\u044F \u0437\u0430\u043C\u0435\u043D\u0430 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u043C \u0444\u043E\u043D\u0442\u0430\u043D\u0430\u043C \u2014 \u0438 \u043F\u043E\u0432\u043E\u0434 \u0432\u044B\u0439\u0442\u0438 \u043D\u0430 \u043F\u0440\u043E\u0433\u0443\u043B\u043A\u0443.",
    photoHint: "\u0421\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u0439 \u043C\u043E\u0441\u0442 \u0438\u043B\u0438 \u0432\u043E\u0434\u0443, \u0430 \u0432 \u043A\u0430\u0434\u0440\u0435 \u2014 \u043C\u043E\u043D\u0435\u0442\u0443 \u0432 \u0440\u0443\u043A\u0435 \u043B\u0438\u0431\u043E \u0443\u0442\u043E\u043A. \u0417\u0438\u043C\u043D\u0438\u0439 \u0438\u043B\u0438 \u043F\u043E\u0437\u0434\u043D\u0435\u043E\u0441\u0435\u043D\u043D\u0438\u0439 \u043F\u0435\u0439\u0437\u0430\u0436 \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442\u0441\u044F.",
    rubric: {
