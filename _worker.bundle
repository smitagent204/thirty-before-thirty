  {
    id: "l2-2",
    level: 2,
    order: 2,
    points: 2,
    emoji: "\u{1F3A8}",
    title: "\u0425\u043E\u043B\u0441\u0442 \u0432 \u0447\u0435\u0442\u044B\u0440\u0435 \u0440\u0443\u043A\u0438 \u0441 \u0433\u043E\u0434\u043E\u0432\u0430\u043B\u044B\u043C \u0441\u043E\u0430\u0432\u0442\u043E\u0440\u043E\u043C",
    description: "\u0412\u044B\u0434\u0430\u0439 \u043C\u0430\u043B\u044B\u0448\u0443 \u0437\u0430\u0433\u0440\u0443\u043D\u0442\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u0445\u043E\u043B\u0441\u0442 \u2014 \u0438\u043B\u0438 \u043F\u043B\u043E\u0442\u043D\u044B\u0439 \u043B\u0438\u0441\u0442/\u043A\u0430\u0440\u0442\u043E\u043D, \u0435\u0441\u043B\u0438 \u0445\u043E\u043B\u0441\u0442\u0430 \u043D\u0435\u0442, \u2014 \u0438 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0435 \u043F\u0430\u043B\u044C\u0447\u0438\u043A\u043E\u0432\u044B\u0435 \u043A\u0440\u0430\u0441\u043A\u0438 \u043D\u0430 10 \u043C\u0438\u043D\u0443\u0442. \u041A\u043E\u0433\u0434\u0430 \u0432\u044B\u0441\u043E\u0445\u043D\u0435\u0442, \u0434\u043E\u0431\u0430\u0432\u044C \u0437\u043E\u043B\u043E\u0442\u0443\u044E \u043F\u043E\u0442\u0430\u043B\u044C \u0438\u043B\u0438 \u0430\u043A\u0440\u0438\u043B, \u043F\u043E\u0434\u043F\u0438\u0448\u0438 \u0441\u0437\u0430\u0434\u0438 \u0434\u0430\u0442\u0443 \u0438 \u043F\u043E\u0432\u0435\u0441\u044C \u043D\u0430 \u0441\u0442\u0435\u043D\u0443. \u0412\u0437\u0440\u043E\u0441\u043B\u0430\u044F \u0434\u043E\u0440\u0430\u0431\u043E\u0442\u043A\u0430 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0434\u0435\u0442\u0441\u043A\u0438\u0435 \u043F\u044F\u0442\u043D\u0430 \u0432 \u0438\u043D\u0442\u0435\u0440\u044C\u0435\u0440\u043D\u0443\u044E \u043A\u0430\u0440\u0442\u0438\u043D\u0443.",
    photoHint: "\u0421\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u0439 \u0433\u043E\u0442\u043E\u0432\u0443\u044E \u0440\u0430\u0431\u043E\u0442\u0443 \u0443\u0436\u0435 \u0432 \u0438\u043D\u0442\u0435\u0440\u044C\u0435\u0440\u0435: \u0432\u0438\u0434\u043D\u044B \u0441\u043B\u0435\u0434\u044B \u0434\u0435\u0442\u0441\u043A\u0438\u0445 \u0440\u0443\u043A \u0438 \u0437\u043E\u043B\u043E\u0442\u044B\u0435 \u0430\u043A\u0446\u0435\u043D\u0442\u044B. \u0415\u0441\u043B\u0438 \u0437\u043E\u043B\u043E\u0442\u0430 \u043D\u0435\u0442 \u2014 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0444\u0430\u043A\u0442\u0443\u0440\u043D\u044B\u0445 \u0432\u0437\u0440\u043E\u0441\u043B\u044B\u0445 \u043C\u0430\u0437\u043A\u043E\u0432.",
    rubric: {
